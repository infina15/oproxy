Функция ОбработкаИзмененияВерсииХранилища(Параметры) Экспорт
	Если Параметры.ИмяСистемы = "snapshot" Тогда
		Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания();
		Завершено = 0;
		Сокетов = 0;
		Для Каждого Задание Из Задания Цикл
			Если Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
				Завершено = Завершено + 1;
			КонецЕсли;
			Если ТипЗнч(Задание.Параметры) = Тип("Массив") Тогда
				Для Каждого Аргумент Из Задание.Параметры Цикл
					Если ТипЗнч(Аргумент) = Тип("TCPСоединение") Тогда
						Сокетов = Сокетов + 1;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		Сообщить(СтрШаблон("SNAP %1 %2 %3", Задания.Количество(), Завершено, Сокетов));
	КонецЕсли;
	Если Параметры.ИмяСистемы = "deny" Тогда
		Возврат "Отклонено проверкой";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ОбработкаПомещенияВХранилище(Параметры) Экспорт
	Если Параметры.ИмяСистемы = "tap" Тогда
		Сообщить("PRE " + Параметры.Комментарий);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПостОбработкаПомещенияВХранилище(Параметры) Экспорт
	Если Параметры.ИмяСистемы = "tap" Тогда
		Сообщить("POST " + Параметры.Комментарий);
	КонецЕсли;
	Возврат Истина;
КонецФункции
