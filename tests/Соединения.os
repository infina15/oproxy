#Использовать asserts
#Использовать autumn
#Использовать ".."

Перем Поделка;

Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт
	ВсеТесты = Новый Массив;
	ВсеТесты.Добавить("ТестДолжен_ПрочитатьДваПингаПоЧастям");
	ВсеТесты.Добавить("ТестДолжен_ПередатьМаркерВнутриДвоичногоТела");
	ВсеТесты.Добавить("ТестДолжен_ЗавершитьЧтениеПриОбрывеЗаголовка");
	ВсеТесты.Добавить("ТестДолжен_ПередаватьДанныеТолькоВСвойКанал");
	ВсеТесты.Добавить("ТестДолжен_ХранитьТелоОтдельноДляКаждогоЗапроса");
	ВсеТесты.Добавить("ТестДолжен_ПересылатьБезПроверкиПослеРаспознаванияМетода");
	Возврат ВсеТесты;
КонецФункции

Процедура ПередЗапускомТеста() Экспорт
	Поделка = Новый Поделка;
	Поделка.ЗапуститьПриложение();
КонецПроцедуры

Функция ТестовоеСоединение()
	Путь = ОбъединитьПути(ТекущийСценарий().Каталог, "Фикстуры", "Соединение.os");
	Возврат ЗагрузитьСценарий(Путь);
КонецФункции

Функция КаналТестовогоСоединения(Соединение)
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить(Соединение);
	ПараметрыКонструктора.Добавить("Конфигуратор");
	Возврат Поделка.НайтиЖелудь("КаналПрокси", ПараметрыКонструктора);
КонецФункции

Процедура ТестДолжен_ПрочитатьДваПингаПоЧастям() Экспорт
	Соединение = ТестовоеСоединение();
	Соединение.ВходящиеДанные.Добавить(ПолучитьДвоичныеДанныеИзHexСтроки("2147"));
	Соединение.ВходящиеДанные.Добавить(ПолучитьДвоичныеДанныеИзHexСтроки("54B3214754B3"));
	Канал = КаналТестовогоСоединения(Соединение);
	ОжидаемыйПинг = ПолучитьДвоичныеДанныеИзHexСтроки("214754B3");

	Для НомерПинга = 1 По 2 Цикл
		Ожидаем.Что(Канал.ПрочитатьЧасть()).Равно(ОжидаемыйПинг);
		Ожидаем.Что(Канал.КонецСообщения()).Равно(Истина);
		Ожидаем.Что(Канал.ЭтоПинг()).Равно(Истина);
	КонецЦикла;
	Ожидаем.Что(Канал.ПрочитатьЧасть()).Равно(Неопределено);
КонецПроцедуры

Процедура ТестДолжен_ПередатьМаркерВнутриДвоичногоТела() Экспорт
	НоваяСтрока = Символы.ВК + Символы.ПС;
	Заголовок = ПолучитьДвоичныеДанныеИзСтроки("POST  HTTP/1.1" + НоваяСтрока
		+ "Content-Length: 6" + НоваяСтрока + "Content-Type: application/octet-stream" + НоваяСтрока + НоваяСтрока);
	ОжидаемоеТело = ПолучитьДвоичныеДанныеИзHexСтроки("AA6653B2A6BB");
	МаркерКонца = ПолучитьДвоичныеДанныеИзHexСтроки("6653B2A6");
	Соединение = ТестовоеСоединение();
	Соединение.ВходящиеДанные.Добавить(Заголовок);
	Соединение.ВходящиеДанные.Добавить(ПолучитьДвоичныеДанныеИзHexСтроки("AA6653B2A6BB6653"));
	Соединение.ВходящиеДанные.Добавить(ПолучитьДвоичныеДанныеИзHexСтроки("B2A6"));
	Канал = КаналТестовогоСоединения(Соединение);

	Ожидаем.Что(Канал.ПрочитатьЧасть()).Равно(Заголовок);
	Ожидаем.Что(Канал.ЭтоПроверяемыйЗапрос()).Равно(Ложь);
	Ожидаем.Что(Канал.ПрочитатьПродолжение()).Равно(ОжидаемоеТело);
	Ожидаем.Что(Канал.КонецСообщения()).Равно(Ложь);
	Ожидаем.Что(Канал.ПрочитатьПродолжение()).Равно(МаркерКонца);
	Ожидаем.Что(Канал.КонецСообщения()).Равно(Истина);
КонецПроцедуры

Процедура ТестДолжен_ЗавершитьЧтениеПриОбрывеЗаголовка() Экспорт
	Соединение = ТестовоеСоединение();
	Соединение.ВходящиеДанные.Добавить(ПолучитьДвоичныеДанныеИзСтроки("POST  HTTP/1.1"));
	Канал = КаналТестовогоСоединения(Соединение);
	Ожидаем.Что(Канал.ПрочитатьЧасть()).Равно(Неопределено);
КонецПроцедуры

Процедура ТестДолжен_ПередаватьДанныеТолькоВСвойКанал() Экспорт
	ПервоеСоединение = ТестовоеСоединение();
	ВтороеСоединение = ТестовоеСоединение();
	ПервыйКанал = КаналТестовогоСоединения(ПервоеСоединение);
	ВторойКанал = КаналТестовогоСоединения(ВтороеСоединение);
	Запрос = ПолучитьДвоичныеДанныеИзСтроки("Запрос");
	Ответ = ПолучитьДвоичныеДанныеИзСтроки("Ответ");

	ПервыйКанал.ОтправитьДвоичныеДанные(Запрос);
	ВторойКанал.ОтправитьДвоичныеДанные(Ответ);
	Ожидаем.Что(ПервоеСоединение.ОтправленныеДанные.Количество()).Равно(1);
	Ожидаем.Что(ПервоеСоединение.ОтправленныеДанные[0]).Равно(Запрос);
	Ожидаем.Что(ВтороеСоединение.ОтправленныеДанные.Количество()).Равно(1);
	Ожидаем.Что(ВтороеСоединение.ОтправленныеДанные[0]).Равно(Ответ);
КонецПроцедуры

Процедура ТестДолжен_ХранитьТелоОтдельноДляКаждогоЗапроса() Экспорт
	ПервоеТело = Поделка.НайтиЖелудь("ТелоЗапросаХранилища");
	ВтороеТело = Поделка.НайтиЖелудь("ТелоЗапросаХранилища");
	НачалоXML = "<call alias=""test"" name=""DevDepot_commitObjects""><comment>";
	КонецXML = "</comment></call>";
	Части = Новый Массив;
	Части.Добавить(ПолучитьДвоичныеДанныеИзСтроки(НачалоXML));
	// Буква Я (D0 AF) пришла в двух чтениях TCP.
	Части.Добавить(ПолучитьДвоичныеДанныеИзHexСтроки("D0"));
	Части.Добавить(ПолучитьДвоичныеДанныеИзHexСтроки("AF"));
	Части.Добавить(ПолучитьДвоичныеДанныеИзСтроки(КонецXML));
	Для Каждого Часть Из Части Цикл
		ПервоеТело.Добавить(Часть);
	КонецЦикла;

	Ожидаем.Что(ВтороеТело.Размер()).Равно(0);
	Ожидаем.Что(ПервоеТело.ПолучитьПараметрыЗапроса().Комментарий).Равно("Я");
	Соединение = ТестовоеСоединение();
	ПервоеТело.ПередатьИОчистить(Соединение);
	Ожидаем.Что(СоединитьДвоичныеДанные(Соединение.ОтправленныеДанные)).Равно(СоединитьДвоичныеДанные(Части));
	Ожидаем.Что(ПервоеТело.Размер()).Равно(0);
КонецПроцедуры

Процедура ТестДолжен_ПересылатьБезПроверкиПослеРаспознаванияМетода() Экспорт
	Заполнитель = ЗаполнительТела();

	ТелоЧтения = Поделка.НайтиЖелудь("ТелоЗапросаХранилища");
	ТелоЧтения.Добавить(ПолучитьДвоичныеДанныеИзСтроки(НачалоВызова("DevDepot_getObjects")));
	Ожидаем.Что(ТелоЧтения.МожноПереслатьБезПроверки(), "начало тела короче порога разбора").Равно(Ложь);
	ТелоЧтения.Добавить(Заполнитель);
	Ожидаем.Что(ТелоЧтения.МожноПереслатьБезПроверки(), "метод чтения не проверяется").Равно(Истина);

	ТелоПомещения = Поделка.НайтиЖелудь("ТелоЗапросаХранилища");
	ТелоПомещения.Добавить(ПолучитьДвоичныеДанныеИзСтроки(НачалоВызова("DevDepot_commitObjects")));
	ТелоПомещения.Добавить(Заполнитель);
	Ожидаем.Что(ТелоПомещения.МожноПереслатьБезПроверки(), "помещение нужно проверить").Равно(Ложь);
	ТелоПомещения.Добавить(Заполнитель);
	Ожидаем.Что(ТелоПомещения.МожноПереслатьБезПроверки(), "решение не меняется по мере чтения").Равно(Ложь);

	ТелоПомещения.Очистить();
	ТелоПомещения.Добавить(ПолучитьДвоичныеДанныеИзСтроки(НачалоВызова("DevDepot_getObjects")));
	ТелоПомещения.Добавить(Заполнитель);
	Ожидаем.Что(ТелоПомещения.МожноПереслатьБезПроверки(), "очистка сбрасывает распознанный метод").Равно(Истина);
КонецПроцедуры

Функция НачалоВызова(ИмяМетода)
	Возврат СтрШаблон("<?xml version=""1.0"" encoding=""UTF-8""?><crs:call xmlns:crs=""http://v8.1c.ru/8.2/crs"" "
		+ "alias=""test"" name=""%1"" version=""8.3.22.2143""><crs:data>", ИмяМетода);
КонецФункции

Функция ЗаполнительТела()
	Текст = "";
	Для Номер = 1 По 30 Цикл
		Текст = Текст + "0123456789";
	КонецЦикла;
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст);
КонецФункции
