// Сеанс одного подключения конфигуратора: пересылает запросы хранилищу и ответы обратно,
// а помещение в хранилище и изменение версий сначала отдаёт на проверку.

&Табакерка
&Пластилин("КаналПрокси")
Перем ФабрикаКаналов;

&Пластилин("ТелоЗапросаХранилища")
Перем ТелоЗапроса;

&Пластилин
Перем НастройкиПрокси;

&ЛогОпрокси
Перем Лог;

Перем РазмерПрерванногоЗапроса Экспорт; // Неопределено, если обмен завершился штатно

Перем СоединениеКонфигуратора;
Перем Конфигуратор;
Перем Хранилище;                  // Неопределено, пока соединение с хранилищем не нужно
Перем ПараметрыПостОбработки;

// Этап обмена определяет, что сторож может делать с соединениями:
// "Прием" — сеанс читает запрос конфигуратора, хранилище не используется;
// "Передача" — запрос уходит в хранилище;
// "Ответ" — сеанс пишет конфигуратору.
Перем Этап;
Перем БлокировкаЭтапа;            // сторож проверяет сеанс под ней, и этап за это время не меняется
Перем ПоследняяПроба;             // мс

Перем ПорогОжидания;              // мс: более короткие ожидания сторож не проверяет
Перем ОжиданиеОтветаБезКлиента;   // мс: сколько хранилище может молчать после отключения клиента
Перем ОжиданиеБезКлиента;         // начало ожидания хранилища, при котором клиент отключился
Перем КлиентОтключилсяВ;

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка Соединение)
	СоединениеКонфигуратора = Соединение;
	Этап = "Прием";
	БлокировкаЭтапа = Новый БлокировкаРесурса;
	ПоследняяПроба = 0;
	ПорогОжидания = 1000;
	ОжиданиеОтветаБезКлиента = 30000;
КонецПроцедуры

// Обслуживает подключение до его закрытия. Оба соединения закрываются в любом случае.
Процедура Обслужить() Экспорт
	ТекстОшибки = "";
	Попытка
		Конфигуратор = НовыйКанал(СоединениеКонфигуратора, "Конфигуратор");
		Конфигуратор.ОтправитьДвоичныеДанные(ПротоколХранилища.Приветствие());
		Пока ОбработатьЗапрос() Цикл
		КонецЦикла;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если РазмерПрерванногоЗапроса = Неопределено Тогда
			РазмерПрерванногоЗапроса = 0;
		КонецЕсли;
	КонецПопытки;

	Закрыть();
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Лог.Ошибка(СтрШаблон("Обмен с хранилищем %1:%2 прерван. %3",
			НастройкиПрокси.АдресСервера, НастройкиПрокси.ПортСервера, ТекстОшибки));
	КонецЕсли;
КонецПроцедуры

// Вызывается сторожем из основного потока.
Процедура ПрерватьПриОбрыве(Сейчас) Экспорт
	Если Конфигуратор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	БлокировкаЭтапа.Заблокировать();
	Попытка
		ПроверитьЭтап(Сейчас);
	Исключение
		БлокировкаЭтапа.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	БлокировкаЭтапа.Разблокировать();
КонецПроцедуры

#Область Сторож

Процедура ПроверитьЭтап(Сейчас)
	Если Этап = "Закрыт" Тогда
		Возврат;
	КонецЕсли;
	Если Этап = "Прием" Тогда
		ЗакрытьУстаревшееХранилище(Сейчас);
	КонецЕсли;
	Если Этап <> "Ответ" Тогда
		ПроверитьКонфигуратор(Сейчас);
	КонецЕсли;
	Если Этап = "Передача" Тогда
		ПрерватьЗапросБезХранилища(Сейчас);
	КонецЕсли;
	Если Этап <> "Прием" Тогда
		ПрерватьОжиданиеХранилищаБезКлиента(Сейчас);
	КонецЕсли;
КонецПроцедуры

// Соединение, которое хранилище закрыло или которое простаивало дольше допустимого,
// закрывается, и следующий запрос уйдёт по новому. Запросы самодостаточны (каждый несёт
// авторизацию), а старое соединение может оказаться мёртвым так, что прокси этого не видит.
// Вызывается, пока сеанс не пользуется хранилищем.
Процедура ЗакрытьУстаревшееХранилище(Сейчас)
	Если Хранилище = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Простой = Сейчас - Хранилище.ПоследняяАктивность();
	Если НЕ Хранилище.Активен() Тогда
		Лог.Информация(СтрШаблон("Хранилище %1:%2 закрыло соединение после %3 с простоя",
			НастройкиПрокси.АдресСервера, НастройкиПрокси.ПортСервера, Секунды(Простой)));
	ИначеЕсли Простой >= НастройкиПрокси.ДопустимыйПростойХранилища() Тогда
		Лог.Отладка(СтрШаблон("Соединение с хранилищем простаивало %1 с и закрыто, следующий запрос пойдёт по новому",
			Секунды(Простой)));
	Иначе
		Возврат;
	КонецЕсли;
	Хранилище.Закрыть();
	Хранилище = Неопределено;
КонецПроцедуры

// Конфигуратор, который долго молчит, проверяется пробным пингом: если его хост пропал
// без разрыва соединения, TCP сам разорвёт соединение, не дождавшись подтверждения.
// Пинг перед ответом конфигуратор принимает так же, как пинги хранилища.
Процедура ПроверитьКонфигуратор(Сейчас)
	Начало = Конфигуратор.НачалоОжидания();
	Если Начало = 0 Или Сейчас - Макс(Начало, ПоследняяПроба) < НастройкиПрокси.ИнтервалПробыКлиента() Тогда
		Возврат;
	КонецЕсли;
	ПоследняяПроба = Сейчас;
	Попытка
		Конфигуратор.ОтправитьПробныйПинг();
	Исключение
		Лог.Информация(СтрШаблон("Конфигуратор не принял пробный пинг, соединение с ним закрыто: %1",
			ИнформацияОбОшибке().Описание));
		Конфигуратор.Закрыть();
	КонецПопытки;
КонецПроцедуры

// Конфигуратор дописывает запрос, а хранилище, которому он адресован, уже закрыло соединение.
Процедура ПрерватьЗапросБезХранилища(Сейчас)
	КаналХранилища = Хранилище;
	Начало = Конфигуратор.НачалоОжидания();
	Если КаналХранилища = Неопределено Или НЕ ЖдетДолго(Начало, Сейчас) Или КаналХранилища.Активен() Тогда
		Возврат;
	КонецЕсли;
	Если Конфигуратор.ПрерватьОжидание(Начало) Тогда
		Лог.Предупреждение(СтрШаблон(
			"Хранилище %1:%2 закрыло соединение, пока конфигуратор передавал запрос. Соединение с конфигуратором закрыто",
			НастройкиПрокси.АдресСервера, НастройкиПрокси.ПортСервера));
	КонецЕсли;
КонецПроцедуры

// Хранилище долго молчит, а конфигуратор уже отключился. Клиент мог закрыть только запись
// и ещё ждать ответ: без прогресса такая пара неотличима от отключившегося клиента
// и молчащего хранилища, поэтому ожидание прерывается не сразу.
Процедура ПрерватьОжиданиеХранилищаБезКлиента(Сейчас)
	КаналХранилища = Хранилище;
	Если КаналХранилища = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Начало = КаналХранилища.НачалоОжидания();
	Если НЕ ЖдетДолго(Начало, Сейчас) Или Конфигуратор.Активен() Тогда
		Возврат;
	КонецЕсли;
	Если ОжиданиеБезКлиента <> Начало Тогда
		ОжиданиеБезКлиента = Начало;
		КлиентОтключилсяВ = Сейчас;
	КонецЕсли;
	Если Сейчас - КлиентОтключилсяВ < ОжиданиеОтветаБезКлиента Тогда
		Возврат;
	КонецЕсли;
	Если КаналХранилища.ПрерватьОжидание(Начало) Тогда
		Лог.Предупреждение(СтрШаблон(
			"Конфигуратор отключился, а хранилище %1:%2 не отвечает %3 с. Соединение с хранилищем закрыто",
			НастройкиПрокси.АдресСервера, НастройкиПрокси.ПортСервера, Секунды(Сейчас - Начало)));
	КонецЕсли;
КонецПроцедуры

Функция ЖдетДолго(Начало, Сейчас)
	Возврат Начало <> 0 И Сейчас - Начало >= ПорогОжидания;
КонецФункции

Функция Секунды(Миллисекунды)
	Возврат Формат(Миллисекунды / 1000, "ЧДЦ=1; ЧН=0; ЧГ=0");
КонецФункции

#КонецОбласти

#Область Обмен

// Пересылает очередной запрос и ответ на него. Возвращает Ложь, когда конфигуратор отключился.
Функция ОбработатьЗапрос()
	УстановитьЭтап("Прием");
	Начало = Конфигуратор.ПрочитатьЧасть();
	Если Начало = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Конфигуратор.ЭтоПинг() Тогда
		// Ответа на пинг конфигуратор не ждёт.
		НачатьПередачу();
		Хранилище.ОтправитьДвоичныеДанные(Начало);
	ИначеЕсли Конфигуратор.ЭтоПроверяемыйЗапрос() Тогда
		Если ПередатьПроверяемыйЗапрос(Начало) Тогда
			ПереслатьОтвет();
			ВыполнитьПостОбработку();
		КонецЕсли;
	Иначе
		НачатьПередачу();
		Хранилище.ОтправитьДвоичныеДанные(Начало);
		Конфигуратор.ПереслатьОстаток(Хранилище);
		ПереслатьОтвет();
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Сторож проверяет сеанс под этой же блокировкой, поэтому после смены этапа он не тронет
// хранилище, которым сеанс начал пользоваться, и не отправит пинг посреди ответа конфигуратору.
Процедура УстановитьЭтап(Значение)
	БлокировкаЭтапа.Заблокировать();
	Этап = Значение;
	БлокировкаЭтапа.Разблокировать();
КонецПроцедуры

// Соединение с хранилищем выбирается непосредственно перед отправкой запроса: пока конфигуратор
// передаёт тело помещения и оно проверяется, прежнее соединение могло устареть.
Процедура НачатьПередачу()
	УстановитьЭтап("Передача");
	ЗакрытьУстаревшееХранилище(ТекущаяУниверсальнаяДатаВМиллисекундах());
	Если Хранилище = Неопределено Тогда
		Соединение = Новый TCPСоединение(НастройкиПрокси.АдресСервера, НастройкиПрокси.ПортСервера);
		Хранилище = НовыйКанал(Соединение, "Хранилище");
		Хранилище.ПропуститьПриветствие();
	КонецЕсли;
КонецПроцедуры

// До ответа хранилище может прислать пинги, они пересылаются как есть. Пока ответ уходит
// конфигуратору, закрытие соединения хранилищем — не повод прерывать обмен: если ответ
// оборвался, сеанс увидит это сам при следующем чтении.
Процедура ПереслатьОтвет()
	УстановитьЭтап("Ответ");
	Пока Истина Цикл
		Если НЕ Хранилище.ПереслатьСообщение(Конфигуратор) Тогда
			ВызватьИсключение "Хранилище закрыло соединение до ответа";
		КонецЕсли;
		Если НЕ Хранилище.ЭтоПинг() Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция НовыйКанал(Соединение, Сторона)
	ПараметрыКанала = Новый Массив;
	ПараметрыКанала.Добавить(Соединение);
	ПараметрыКанала.Добавить(Сторона);
	Попытка
		Возврат ФабрикаКаналов.Достать(ПараметрыКанала);
	Исключение
		Соединение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Процедура Закрыть()
	УстановитьЭтап("Закрыт");
	Если Конфигуратор <> Неопределено Тогда
		Конфигуратор.ЗавершитьОбмен();
	КонецЕсли;
	Если Хранилище <> Неопределено Тогда
		Хранилище.ЗавершитьОбмен();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Проверка

// Возвращает Истина, если запрос передан хранилищу и нужно переслать ответ.
Функция ПередатьПроверяемыйЗапрос(Заголовок)
	Попытка
		Возврат ПроверитьИПередатьЗапрос(Заголовок);
	Исключение
		РазмерПрерванногоЗапроса = ТелоЗапроса.Размер();
		ТелоЗапроса.Очистить();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

// Тело копится в памяти до решения проверки. Если по началу тела понятно,
// что метод не проверяется, накопленное уходит в хранилище, а остаток пересылается сразу.
Функция ПроверитьИПередатьЗапрос(Заголовок)
	Часть = Конфигуратор.ПрочитатьПродолжение();
	Пока НЕ Конфигуратор.КонецСообщения() Цикл
		ТелоЗапроса.Добавить(Часть);
		// Байты уже в ТелеЗапроса. Стек ошибки следующего чтения может жить вместе с заданием.
		ОсвободитьОбъект(Часть);
		Если ТелоЗапроса.МожноПереслатьБезПроверки() Тогда
			НачатьПередачу();
			Хранилище.ОтправитьДвоичныеДанные(Заголовок);
			ТелоЗапроса.ПередатьИОчистить(Хранилище);
			Конфигуратор.ПереслатьОстаток(Хранилище);
			Возврат Истина;
		КонецЕсли;
		Часть = Конфигуратор.ПрочитатьПродолжение();
	КонецЦикла;
	МаркерКонца = Часть;

	ПараметрыЗапроса = ТелоЗапроса.ПолучитьПараметрыЗапроса();
	Если ПараметрыЗапроса.Проверять = Истина Тогда
		ТекстОшибки = ПроверитьЗапрос(ПараметрыЗапроса);
		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			ТелоЗапроса.Очистить();
			УстановитьЭтап("Ответ");
			Конфигуратор.ОтправитьДвоичныеДанные(ОбработкаДанных.ПолучитьДвоичныеДанныеОтветаОшибки(ТекстОшибки));
			Возврат Ложь;
		КонецЕсли;
		ПараметрыПостОбработки = ПараметрыЗапроса;
	КонецЕсли;

	НачатьПередачу();
	Хранилище.ОтправитьДвоичныеДанные(Заголовок);
	ТелоЗапроса.ПередатьИОчистить(Хранилище);
	Хранилище.ОтправитьДвоичныеДанные(МаркерКонца);
	Возврат Истина;
КонецФункции

// Возвращает текст ошибки проверки или пустую строку.
Функция ПроверитьЗапрос(ПараметрыЗапроса)
	Проверки = НастройкиПрокси.Проверки;
	Попытка
		Если ПараметрыЗапроса.ИмяМетода = ПротоколХранилища.МетодПомещенияВХранилище() Тогда
			Возврат Проверки.ОбработкаПомещенияВХранилище(ПараметрыЗапроса);
		ИначеЕсли ПараметрыЗапроса.ИмяМетода = ПротоколХранилища.МетодИзмененияВерсии() Тогда
			Возврат Проверки.ОбработкаИзмененияВерсииХранилища(ПараметрыЗапроса);
		КонецЕсли;
	Исключение
		ТекстОшибки = СтрШаблон("Ошибка вызова функции в файле ""ПроверкиПроксиСервера.os"": %1", ОписаниеОшибки());
		Лог.Ошибка(ТекстОшибки);
		Возврат ТекстОшибки;
	КонецПопытки;
	ВызватьИсключение СтрШаблон("Нет проверки для метода %1", ПараметрыЗапроса.ИмяМетода);
КонецФункции

Процедура ВыполнитьПостОбработку()
	Если ПараметрыПостОбработки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыЗапроса = ПараметрыПостОбработки;
	ПараметрыПостОбработки = Неопределено;
	Попытка
		НастройкиПрокси.Проверки.ПостОбработкаПомещенияВХранилище(ПараметрыЗапроса);
	Исключение
		Лог.Ошибка(СтрШаблон("Ошибка вызова функции пост обработки в файле ""ПроверкиПроксиСервера.os"": %1",
			ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
