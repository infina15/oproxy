// Сеанс одного подключения конфигуратора: пересылает запросы хранилищу и ответы обратно,
// а помещение в хранилище и изменение версий сначала отдаёт на проверку.

&Табакерка
&Пластилин("КаналПрокси")
Перем ФабрикаКаналов;

&Пластилин("ТелоЗапросаХранилища")
Перем ТелоЗапроса;

&Пластилин
Перем НастройкиПрокси;

&ЛогОпрокси
Перем Лог;

Перем СоединениеКонфигуратора;
Перем Конфигуратор;
Перем Хранилище;
Перем ПараметрыПостОбработки;

Перем ЖдетЗапрос;                 // сеанс ждёт следующий запрос конфигуратора
Перем БлокировкаКлиента;          // чтобы пробный пинг не попал внутрь ответа конфигуратору
Перем ПоследняяПроба;             // мс

Перем ПорогОжидания;              // мс: более короткие ожидания сторож не проверяет
Перем ОжиданиеОтветаБезКлиента;   // мс: сколько хранилище может молчать после отключения клиента
Перем ОжиданиеБезКлиента;         // начало ожидания хранилища, при котором клиент отключился
Перем КлиентОтключилсяВ;

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка Соединение)
	СоединениеКонфигуратора = Соединение;
	ЖдетЗапрос = Ложь;
	БлокировкаКлиента = Новый БлокировкаРесурса;
	ПоследняяПроба = 0;
	ПорогОжидания = 1000;
	ОжиданиеОтветаБезКлиента = 30000;
КонецПроцедуры

// Обслуживает подключение до его закрытия. Оба соединения закрываются в любом случае.
Процедура Обслужить() Экспорт
	ТекстОшибки = "";
	Попытка
		Конфигуратор = НовыйКанал(СоединениеКонфигуратора);
		Конфигуратор.ОтправитьДвоичныеДанные(ПротоколХранилища.Приветствие());
		Пока ОбработатьЗапрос() Цикл
		КонецЦикла;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Закрыть();
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Лог.Ошибка(СтрШаблон("Соединение с хранилищем %1:%2 прервано. %3",
			НастройкиПрокси.АдресСервера, НастройкиПрокси.ПортСервера, ТекстОшибки));
	КонецЕсли;
КонецПроцедуры

// Вызывается сторожем из основного потока.
Процедура ПрерватьПриОбрыве(Сейчас) Экспорт
	Если Конфигуратор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЖдетЗапрос Тогда
		ПроверитьПростой(Сейчас);
	Иначе
		ПрерватьЗависшийОбмен(Сейчас);
	КонецЕсли;
КонецПроцедуры

#Область Сторож

// Между запросами. Запросы самодостаточны (каждый несёт авторизацию), поэтому соединение,
// которое хранилище закрыло во время простоя, просто освобождается: следующий запрос уйдёт
// по новому. Конфигуратор время от времени проверяется пробным пингом: если его хост пропал
// без разрыва соединения, TCP сам разорвёт его, не дождавшись подтверждения.
Процедура ПроверитьПростой(Сейчас)
	КаналХранилища = Хранилище;
	Если КаналХранилища <> Неопределено И НЕ КаналХранилища.Активен() Тогда
		КаналХранилища.Закрыть();
	КонецЕсли;

	Начало = Конфигуратор.НачалоОжидания();
	Если Начало = 0 Или Сейчас - Макс(Начало, ПоследняяПроба) < НастройкиПрокси.ИнтервалПробыКлиента() Тогда
		Возврат;
	КонецЕсли;
	ПоследняяПроба = Сейчас;
	БлокировкаКлиента.Заблокировать();
	Попытка
		Если ЖдетЗапрос Тогда
			Конфигуратор.ОтправитьПробныйПинг();
		КонецЕсли;
	Исключение
		// Пинг не ушёл: конфигуратора уже нет.
		Конфигуратор.Закрыть();
	КонецПопытки;
	БлокировкаКлиента.Разблокировать();
КонецПроцедуры

// Во время обмена. Прерывает ожидание, если ждать уже некого: конфигуратор дописывает запрос
// отключившемуся хранилищу или хранилище долго молчит после отключения клиента.
Процедура ПрерватьЗависшийОбмен(Сейчас)
	КаналХранилища = Хранилище;
	Если КаналХранилища = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Начало = Конфигуратор.НачалоОжидания();
	Если ЖдетДолго(Начало, Сейчас) И НЕ КаналХранилища.Активен() Тогда
		Конфигуратор.ПрерватьОжидание(Начало);
	КонецЕсли;

	Начало = КаналХранилища.НачалоОжидания();
	Если НЕ ЖдетДолго(Начало, Сейчас) Или Конфигуратор.Активен() Тогда
		Возврат;
	КонецЕсли;
	// Клиент мог закрыть только запись и ещё ждать ответ. Без прогресса такая пара
	// неотличима от отключившегося клиента и молчащего хранилища.
	Если ОжиданиеБезКлиента <> Начало Тогда
		ОжиданиеБезКлиента = Начало;
		КлиентОтключилсяВ = Сейчас;
	КонецЕсли;
	Если Сейчас - КлиентОтключилсяВ >= ОжиданиеОтветаБезКлиента Тогда
		КаналХранилища.ПрерватьОжидание(Начало);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Обмен

// Пересылает очередной запрос и ответ на него. Возвращает Ложь, когда конфигуратор отключился.
Функция ОбработатьЗапрос()
	УстановитьОжиданиеЗапроса(Истина);
	Начало = Конфигуратор.ПрочитатьЧасть();
	УстановитьОжиданиеЗапроса(Ложь);
	Если Начало = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Хранилище = Неопределено Или НЕ Хранилище.Активен() Тогда
		ПодключитьсяКХранилищу();
	КонецЕсли;

	Если Конфигуратор.ЭтоПинг() Тогда
		// Ответа на пинг конфигуратор не ждёт.
		Хранилище.ОтправитьДвоичныеДанные(Начало);
	ИначеЕсли Конфигуратор.ЭтоПроверяемыйЗапрос() Тогда
		Если ПередатьПроверяемыйЗапрос(Начало) Тогда
			ПереслатьОтвет();
			ВыполнитьПостОбработку();
		КонецЕсли;
	Иначе
		Хранилище.ОтправитьДвоичныеДанные(Начало);
		Конфигуратор.ПереслатьОстаток(Хранилище);
		ПереслатьОтвет();
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Пока сеанс ждёт запрос, сторож может отправить конфигуратору пробный пинг.
// Признак снимается под блокировкой раньше любой отправки конфигуратору,
// поэтому пинг не окажется внутри ответа.
Процедура УстановитьОжиданиеЗапроса(Значение)
	БлокировкаКлиента.Заблокировать();
	ЖдетЗапрос = Значение;
	БлокировкаКлиента.Разблокировать();
КонецПроцедуры

Процедура ПодключитьсяКХранилищу()
	Если Хранилище <> Неопределено Тогда
		Хранилище.Закрыть();
		Лог.Информация(СтрШаблон("Хранилище %1:%2 закрыло простаивающее соединение, подключаюсь заново",
			НастройкиПрокси.АдресСервера, НастройкиПрокси.ПортСервера));
	КонецЕсли;
	Соединение = Новый TCPСоединение(НастройкиПрокси.АдресСервера, НастройкиПрокси.ПортСервера);
	Хранилище = НовыйКанал(Соединение);
	Хранилище.ПропуститьПриветствие();
КонецПроцедуры

// До ответа хранилище может прислать пинги, они пересылаются как есть.
Процедура ПереслатьОтвет()
	Пока Истина Цикл
		Если НЕ Хранилище.ПереслатьСообщение(Конфигуратор) Тогда
			ВызватьИсключение "Хранилище закрыло соединение до ответа";
		КонецЕсли;
		Если НЕ Хранилище.ЭтоПинг() Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция НовыйКанал(Соединение)
	ПараметрыКанала = Новый Массив;
	ПараметрыКанала.Добавить(Соединение);
	Попытка
		Возврат ФабрикаКаналов.Достать(ПараметрыКанала);
	Исключение
		Соединение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Процедура Закрыть()
	Если Конфигуратор <> Неопределено Тогда
		Конфигуратор.Закрыть();
	КонецЕсли;
	Если Хранилище <> Неопределено Тогда
		Хранилище.Закрыть();
	КонецЕсли;
КонецПроцедуры

Функция ЖдетДолго(Начало, Сейчас)
	Возврат Начало <> 0 И Сейчас - Начало >= ПорогОжидания;
КонецФункции

#КонецОбласти

#Область Проверка

// Возвращает Истина, если запрос передан хранилищу и нужно переслать ответ.
Функция ПередатьПроверяемыйЗапрос(Заголовок)
	Попытка
		Возврат ПроверитьИПередатьЗапрос(Заголовок);
	Исключение
		ТелоЗапроса.Очистить();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

// Тело копится в памяти до решения проверки. Если по началу тела понятно,
// что метод не проверяется, накопленное уходит в хранилище, а остаток пересылается сразу.
Функция ПроверитьИПередатьЗапрос(Заголовок)
	Часть = Конфигуратор.ПрочитатьПродолжение();
	Пока НЕ Конфигуратор.КонецСообщения() Цикл
		ТелоЗапроса.Добавить(Часть);
		Если ТелоЗапроса.МожноПереслатьБезПроверки() Тогда
			Хранилище.ОтправитьДвоичныеДанные(Заголовок);
			ТелоЗапроса.ПередатьИОчистить(Хранилище);
			Конфигуратор.ПереслатьОстаток(Хранилище);
			Возврат Истина;
		КонецЕсли;
		Часть = Конфигуратор.ПрочитатьПродолжение();
	КонецЦикла;
	МаркерКонца = Часть;

	ПараметрыЗапроса = ТелоЗапроса.ПолучитьПараметрыЗапроса();
	Если ПараметрыЗапроса.Проверять = Истина Тогда
		ТекстОшибки = ПроверитьЗапрос(ПараметрыЗапроса);
		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			ТелоЗапроса.Очистить();
			Конфигуратор.ОтправитьДвоичныеДанные(ОбработкаДанных.ПолучитьДвоичныеДанныеОтветаОшибки(ТекстОшибки));
			Возврат Ложь;
		КонецЕсли;
		ПараметрыПостОбработки = ПараметрыЗапроса;
	КонецЕсли;

	Хранилище.ОтправитьДвоичныеДанные(Заголовок);
	ТелоЗапроса.ПередатьИОчистить(Хранилище);
	Хранилище.ОтправитьДвоичныеДанные(МаркерКонца);
	Возврат Истина;
КонецФункции

// Возвращает текст ошибки проверки или пустую строку.
Функция ПроверитьЗапрос(ПараметрыЗапроса)
	Проверки = НастройкиПрокси.Проверки;
	Попытка
		Если ПараметрыЗапроса.ИмяМетода = ПротоколХранилища.МетодПомещенияВХранилище() Тогда
			Возврат Проверки.ОбработкаПомещенияВХранилище(ПараметрыЗапроса);
		ИначеЕсли ПараметрыЗапроса.ИмяМетода = ПротоколХранилища.МетодИзмененияВерсии() Тогда
			Возврат Проверки.ОбработкаИзмененияВерсииХранилища(ПараметрыЗапроса);
		КонецЕсли;
	Исключение
		ТекстОшибки = СтрШаблон("Ошибка вызова функции в файле ""ПроверкиПроксиСервера.os"": %1", ОписаниеОшибки());
		Лог.Ошибка(ТекстОшибки);
		Возврат ТекстОшибки;
	КонецПопытки;
	ВызватьИсключение СтрШаблон("Нет проверки для метода %1", ПараметрыЗапроса.ИмяМетода);
КонецФункции

Процедура ВыполнитьПостОбработку()
	Если ПараметрыПостОбработки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыЗапроса = ПараметрыПостОбработки;
	ПараметрыПостОбработки = Неопределено;
	Попытка
		НастройкиПрокси.Проверки.ПостОбработкаПомещенияВХранилище(ПараметрыЗапроса);
	Исключение
		Лог.Ошибка(СтрШаблон("Ошибка вызова функции пост обработки в файле ""ПроверкиПроксиСервера.os"": %1",
			ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
