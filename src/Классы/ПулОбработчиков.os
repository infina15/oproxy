// До четырёх обработчиков принимают первые подключения. Основной поток увеличивает пул,
// если все обработчики заняты длительно. На пределе новые подключения ждут в очереди TCP.
// Задания используются повторно: OneScript 1.9 хранит завершённые задания до конца процесса.

&Пластилин
Перем ОбработчикСоединений;

&Пластилин
Перем НастройкиПрокси;

&ЛогОпрокси
Перем Лог;

Перем Сервер;
Перем Запущен;
Перем БлокировкаПриема;
Перем БлокировкаСчетчика;
Перем СвободныхОбработчиков;
Перем ВсегоОбработчиков;
Перем ВсеЗанятыС; // мс, 0 — есть свободный обработчик
Перем ПределОбработчиков;

&Желудь
Процедура ПриСозданииОбъекта()
	Запущен = Ложь;
	БлокировкаПриема = Новый БлокировкаРесурса;
	БлокировкаСчетчика = Новый БлокировкаРесурса;
	СвободныхОбработчиков = 0;
	ВсегоОбработчиков = 0;
	ВсеЗанятыС = 0;
КонецПроцедуры

Процедура Запустить(TCPСервер) Экспорт
	Сервер = TCPСервер;
	ПределОбработчиков = НастройкиПрокси.МаксимумОбработчиков();
	Запущен = Истина;
	Пополнить();
КонецПроцедуры

// Прекращает приём подключений. Уже принятые подключения обслуживаются до конца.
Процедура Остановить() Экспорт
	Запущен = Ложь;
	Попытка
		Сервер.Остановить();
	Исключение
		// Сервер мог уже остановиться из-за ошибки приёма.
	КонецПопытки;
КонецПроцедуры

Функция Работает() Экспорт
	Возврат Запущен;
КонецФункции

// Тело фонового задания.
Процедура ОбслуживатьПодключения() Экспорт
	Пока Истина Цикл
		Соединение = ПринятьСоединение();
		Если Соединение = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ЗанятьОбработчик();
		Обслужить(Соединение);
		// Закрытый сокет не должен жить в задании до следующего подключения.
		Соединение = Неопределено;
		ОсвободитьОбработчик();
	КонецЦикла;
КонецПроцедуры

// Подключения ждёт только один обработчик. Возвращает Неопределено, если пул остановлен.
Функция ПринятьСоединение()
	БлокировкаПриема.Заблокировать();
	Если НЕ Запущен Тогда
		БлокировкаПриема.Разблокировать();
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Соединение = Сервер.ОжидатьСоединения();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		БлокировкаПриема.Разблокировать();
		Если Запущен Тогда
			Лог.Ошибка(СтрШаблон("Прокси-сервер остановлен. %1", ТекстОшибки));
			Остановить();
		КонецЕсли;
		Возврат Неопределено;
	КонецПопытки;
	БлокировкаПриема.Разблокировать();
	Возврат Соединение;
КонецФункции

Процедура Обслужить(Соединение)
	Попытка
		// Обработчик сам закрывает соединение.
		ОбработчикСоединений.ОбработатьСоединение(Соединение);
	Исключение
		Лог.Ошибка(СтрШаблон("Не удалось обслужить подключение. %1", ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

// Вызывается из основного потока. Короткие пики обслуживает существующий пул.
Процедура Пополнить() Экспорт
	БлокировкаСчетчика.Заблокировать();
	Попытка
		Если Запущен И ВсегоОбработчиков < ПределОбработчиков Тогда
			Если ВсегоОбработчиков = 0 Тогда
				ДобавитьОбработчиков(4);
			ИначеЕсли ВсеЗанятыС <> 0 И ТекущаяУниверсальнаяДатаВМиллисекундах() - ВсеЗанятыС >= 250 Тогда
				ДобавитьОбработчиков(ВсегоОбработчиков);
			КонецЕсли;
		КонецЕсли;
	Исключение
		БлокировкаСчетчика.Разблокировать();
		Остановить();
		ВызватьИсключение;
	КонецПопытки;
	БлокировкаСчетчика.Разблокировать();
КонецПроцедуры

Процедура ДобавитьОбработчиков(Количество)
	НовыхОбработчиков = Мин(Количество, ПределОбработчиков - ВсегоОбработчиков);
	Для Номер = 1 По НовыхОбработчиков Цикл
		ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОбслуживатьПодключения", , Истина);
		ВсегоОбработчиков = ВсегоОбработчиков + 1;
		СвободныхОбработчиков = СвободныхОбработчиков + 1;
	КонецЦикла;
	ВсеЗанятыС = 0;
КонецПроцедуры

Процедура ЗанятьОбработчик()
	БлокировкаСчетчика.Заблокировать();
	СвободныхОбработчиков = СвободныхОбработчиков - 1;
	Если СвободныхОбработчиков = 0 Тогда
		ВсеЗанятыС = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецЕсли;
	БлокировкаСчетчика.Разблокировать();
КонецПроцедуры

Процедура ОсвободитьОбработчик()
	БлокировкаСчетчика.Заблокировать();
	СвободныхОбработчиков = СвободныхОбработчиков + 1;
	ВсеЗанятыС = 0;
	БлокировкаСчетчика.Разблокировать();
КонецПроцедуры
