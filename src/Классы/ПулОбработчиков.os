// Фоновые задания, которые принимают подключения и обслуживают их.
// Схема «ведущий и ведомые»: одно свободное задание ждёт подключения, остальные обслуживают
// свои соединения. Задание, принявшее подключение, запускает новое, если свободных не осталось.
// Обслужив подключение, задание возвращается в пул и не завершается: завершённые фоновые
// задания OneScript продолжают хранить свои параметры, а с ними и сокеты.

&Пластилин
Перем ОбработчикСоединений;

&ЛогОпрокси
Перем Лог;

Перем Сервер;
Перем Запущен;
Перем БлокировкаПриема;
Перем БлокировкаСчетчика;
Перем СвободныхОбработчиков;

&Желудь
Процедура ПриСозданииОбъекта()
	Запущен = Ложь;
	БлокировкаПриема = Новый БлокировкаРесурса;
	БлокировкаСчетчика = Новый БлокировкаРесурса;
	СвободныхОбработчиков = 0;
КонецПроцедуры

Процедура Запустить(TCPСервер) Экспорт
	Сервер = TCPСервер;
	Запущен = Истина;
	СвободныхОбработчиков = 1;
	ЗапуститьОбработчик();
КонецПроцедуры

// Прекращает приём подключений. Уже принятые подключения обслуживаются до конца.
Процедура Остановить() Экспорт
	Запущен = Ложь;
	Попытка
		Сервер.Остановить();
	Исключение
		// Сервер мог уже остановиться из-за ошибки приёма.
	КонецПопытки;
КонецПроцедуры

Функция Работает() Экспорт
	Возврат Запущен;
КонецФункции

// Тело фонового задания.
Процедура ОбслуживатьПодключения() Экспорт
	Пока Истина Цикл
		Соединение = ПринятьСоединение();
		Если Соединение = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ЗанятьОбработчик();
		Обслужить(Соединение);
		// Закрытый сокет не должен жить в задании до следующего подключения.
		Соединение = Неопределено;
		ОсвободитьОбработчик();
	КонецЦикла;
КонецПроцедуры

// Подключения ждёт только один обработчик. Возвращает Неопределено, если пул остановлен.
Функция ПринятьСоединение()
	БлокировкаПриема.Заблокировать();
	Если НЕ Запущен Тогда
		БлокировкаПриема.Разблокировать();
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Соединение = Сервер.ОжидатьСоединения();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		БлокировкаПриема.Разблокировать();
		Если Запущен Тогда
			Лог.Ошибка(СтрШаблон("Прокси-сервер остановлен. %1", ТекстОшибки));
			Остановить();
		КонецЕсли;
		Возврат Неопределено;
	КонецПопытки;
	БлокировкаПриема.Разблокировать();
	Возврат Соединение;
КонецФункции

Процедура Обслужить(Соединение)
	Попытка
		// Обработчик сам закрывает соединение.
		ОбработчикСоединений.ОбработатьСоединение(Соединение);
	Исключение
		Лог.Ошибка(СтрШаблон("Не удалось обслужить подключение. %1", ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

// Если текущий обработчик был последним свободным, запускает новый, чтобы приём не прерывался.
Процедура ЗанятьОбработчик()
	БлокировкаСчетчика.Заблокировать();
	СвободныхОбработчиков = СвободныхОбработчиков - 1;
	НуженНовый = СвободныхОбработчиков = 0;
	Если НуженНовый Тогда
		СвободныхОбработчиков = 1;
	КонецЕсли;
	БлокировкаСчетчика.Разблокировать();
	Если НуженНовый Тогда
		ЗапуститьОбработчик();
	КонецЕсли;
КонецПроцедуры

Процедура ОсвободитьОбработчик()
	БлокировкаСчетчика.Заблокировать();
	СвободныхОбработчиков = СвободныхОбработчиков + 1;
	БлокировкаСчетчика.Разблокировать();
КонецПроцедуры

Процедура ЗапуститьОбработчик()
	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОбслуживатьПодключения", , Истина);
КонецПроцедуры
