// Строка лога с местным временем до миллисекунд: по нему ошибку в конфигураторе
// можно сопоставить с записью прокси.

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

Функция ПолучитьФорматированноеСообщение(СобытиеЛога) Экспорт
	ВремяСобытия = СобытиеЛога.ПолучитьВремяСобытия();
	МестноеВремяСобытия = МестноеВремя(Дата(1, 1, 1) + Цел(ВремяСобытия / 1000));
	Возврат СтрШаблон("%1.%2 %3 - %4",
		Формат(МестноеВремяСобытия, "ДФ='yyyy-MM-dd HH:mm:ss'"),
		Формат(ВремяСобытия % 1000, "ЧЦ=3; ЧВН=; ЧГ=0"),
		УровниЛога.НаименованиеУровня(СобытиеЛога.ПолучитьУровень()),
		СобытиеЛога.ПолучитьСообщение());
КонецФункции
