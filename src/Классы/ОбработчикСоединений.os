Перем ПроверкиПроксиСервера Экспорт;
Перем АдресСервера Экспорт;
Перем ПортСервера Экспорт;
Перем ПриветствиеХранилища;
Перем Каналы, БлокировкаКаналов;

&ЛогОпрокси
Перем Лог;

&Желудь
Процедура ПриСозданииОбъекта()
	ПриветствиеХранилища = ПолучитьДвоичныеДанныеИзHexСтроки("53F5C61A7B");
	Каналы = Новый Соответствие;
	БлокировкаКаналов = Новый БлокировкаРесурса;
КонецПроцедуры

Процедура ОбработатьСоединение(Соединение_Конфигуратор) Экспорт
	Перем Конец, Пинг;
	Клиент = Новый КаналПрокси(Соединение_Конфигуратор);
	Хранилище = Неопределено;
	ТекстОшибки = "";
	Попытка
		Клиент.ОтправитьДвоичныеДанные(ПриветствиеХранилища);
		Часть = Клиент.ПрочитатьЧасть(Конец, Пинг);
		Если Часть <> Неопределено Тогда
			Сокет = Новый TCPСоединение(АдресСервера, ПортСервера);
			Хранилище = Новый КаналПрокси(Сокет);
			БлокировкаКаналов.Заблокировать();
			Каналы.Вставить(Клиент, Хранилище);
			БлокировкаКаналов.Разблокировать();
			Хранилище.ПропуститьПриветствие(ПриветствиеХранилища.Размер());
		КонецЕсли;
		Пока Часть <> Неопределено Цикл
			ПостОбработка = Неопределено;
			Если Пинг Тогда
				Хранилище.ОтправитьДвоичныеДанные(Часть);
			Иначе
				Если Клиент.ПроверятьЗапрос Тогда
					Принят = ПередатьPOST(Клиент, Хранилище, Часть, ПостОбработка);
				Иначе
					ПереслатьСообщение(Клиент, Хранилище, Часть, Конец);
					Принят = Истина;
				КонецЕсли;
				Если Принят Тогда
					ПередатьОтвет(Хранилище, Клиент);
					Если ПостОбработка <> Неопределено Тогда
						ПостОбработкаПомещенияВХранилище(ПостОбработка);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Часть = Неопределено;
			Часть = Клиент.ПрочитатьЧасть(Конец, Пинг);
		КонецЦикла;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	БлокировкаКаналов.Заблокировать();
	Каналы.Удалить(Клиент);
	БлокировкаКаналов.Разблокировать();
	Клиент.Закрыть();
	Если Хранилище <> Неопределено Тогда
		Хранилище.Закрыть();
	КонецЕсли;
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Лог.Ошибка(СтрШаблон("Соединение с хранилищем %1:%2 прервано. %3", АдресСервера, ПортСервера, ТекстОшибки));
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОжидающиеКаналы() Экспорт
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	БлокировкаКаналов.Заблокировать();
	Попытка
		Для Каждого Пара Из Каналы Цикл
			Пара.Ключ.ПрерватьОжиданиеПриОбрыве(Пара.Значение, Сейчас);
			Пара.Значение.ПрерватьОжиданиеПриОбрыве(Пара.Ключ, Сейчас, Истина);
		КонецЦикла;
	Исключение
		БлокировкаКаналов.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	БлокировкаКаналов.Разблокировать();
КонецПроцедуры

Функция ПрочитатьПродолжение(Канал, Конец)
	Перем Пинг;
	Часть = Канал.ПрочитатьЧасть(Конец, Пинг);
	Если Часть = Неопределено Тогда
		ВызватьИсключение "Соединение закрыто до конца сообщения";
	КонецЕсли;
	Возврат Часть;
КонецФункции

Процедура ПереслатьСообщение(Источник, Приемник, Знач Часть, Знач Конец)
	Приемник.ОтправитьДвоичныеДанные(Часть);
	Пока НЕ Конец Цикл
		Часть = ПрочитатьПродолжение(Источник, Конец);
		Приемник.ОтправитьДвоичныеДанные(Часть);
	КонецЦикла;
КонецПроцедуры

Процедура ПередатьОтвет(Хранилище, Клиент)
	Перем Конец, Пинг;
	Пока Истина Цикл
		Часть = Хранилище.ПрочитатьЧасть(Конец, Пинг);
		Если Часть = Неопределено Тогда
			ВызватьИсключение "Хранилище закрыло соединение до ответа";
		КонецЕсли;
		ПереслатьСообщение(Хранилище, Клиент, Часть, Конец);
		Если НЕ Пинг Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПередатьPOST(Клиент, Хранилище, Заголовок, ПостОбработка)
	Тело = Новый ТелоЗапросаХранилища;
	Попытка
		Возврат ПроверитьИПередатьPOST(Клиент, Хранилище, Заголовок, Тело, ПостОбработка);
	Исключение
		Тело.Очистить();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция ПроверитьИПередатьPOST(Клиент, Хранилище, Заголовок, Тело, ПостОбработка)
	Перем Конец;
	СледующийРазбор = 256;
	МетодИзвестен = Ложь;
	Пока Истина Цикл
		Часть = ПрочитатьПродолжение(Клиент, Конец);
		Если Конец Тогда
			Прервать;
		КонецЕсли;
		Тело.Добавить(Часть);
		Пока НЕ МетодИзвестен И Тело.Размер >= СледующийРазбор Цикл
			// До распознавания метода сохраняем начало POST, даже если имя разрезано между чтениями.
			Параметры = Тело.ПараметрыЗапроса(СледующийРазбор);
			МетодИзвестен = ЗначениеЗаполнено(Параметры.ИмяМетода);
			Если МетодИзвестен И Параметры.Проверять <> Истина Тогда
				Хранилище.ОтправитьДвоичныеДанные(Заголовок);
				Тело.ПередатьИОчистить(Хранилище);
				Часть = ПрочитатьПродолжение(Клиент, Конец);
				ПереслатьСообщение(Клиент, Хранилище, Часть, Конец);
				Возврат Истина;
			КонецЕсли;
			СледующийРазбор = СледующийРазбор * 2;
		КонецЦикла;
	КонецЦикла;
	Параметры = Тело.ПараметрыЗапроса();
	Если Параметры.Проверять = Истина Тогда
		Попытка
			Если Параметры.ИмяМетода = "DevDepot_commitObjects" Тогда
				ТекстОшибки = ПроверкиПроксиСервера.ОбработкаПомещенияВХранилище(Параметры);
			Иначе
				ТекстОшибки = ПроверкиПроксиСервера.ОбработкаИзмененияВерсииХранилища(Параметры);
			КонецЕсли;
		Исключение
			ТекстОшибки = СтрШаблон("Ошибка вызова функции в файле ""ПроверкиПроксиСервера.os"": %1", ОписаниеОшибки());
			Лог.Ошибка(ТекстОшибки);
		КонецПопытки;
		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			Тело.Очистить();
			Клиент.ОтправитьДвоичныеДанные(ОбработкаДанных.ПолучитьДвоичныеДанныеОтветаОшибки(ТекстОшибки));
			Возврат Ложь;
		КонецЕсли;
		ПостОбработка = Параметры;
	КонецЕсли;
	Хранилище.ОтправитьДвоичныеДанные(Заголовок);
	Тело.ПередатьИОчистить(Хранилище);
	Хранилище.ОтправитьДвоичныеДанные(Часть);
	Возврат Истина;
КонецФункции

Процедура ПостОбработкаПомещенияВХранилище(ПараметрыЗапроса)

	Попытка
		РезультатБулево = ПроверкиПроксиСервера.ПостОбработкаПомещенияВХранилище(ПараметрыЗапроса);
	Исключение
		ТекстОшибки = СтрШаблон("Ошибка вызова функции пост обработки в файле ""ПроверкиПроксиСервера.os"": %1", ОписаниеОшибки()); 
		Лог.Ошибка(ТекстОшибки);
	КонецПопытки;

КонецПроцедуры
