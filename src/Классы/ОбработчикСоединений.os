// Обслуживает подключения конфигураторов: каждое подключение — отдельный СеансПрокси.
// Основной поток периодически вызывает ПрерватьОборванныеСеансы, чтобы освободить
// обработчики, зависшие на чтении после обрыва связи.

&Табакерка
&Пластилин("СеансПрокси")
Перем ФабрикаСеансов;

&ЛогОпрокси
Перем Лог;

Перем Сеансы;
Перем БлокировкаСеансов;
Перем НужнаСборка;
Перем СборкаВыполняется;
Перем СледующаяСборка;

&Желудь
Процедура ПриСозданииОбъекта()
	Сеансы = Новый Соответствие;
	НужнаСборка = Ложь;
	СборкаВыполняется = Ложь;
	СледующаяСборка = 0;
	БлокировкаСеансов = Новый БлокировкаРесурса;
КонецПроцедуры

// Обслуживает подключение до его закрытия. Соединение закрывается в любом случае.
Процедура ОбработатьСоединение(Соединение) Экспорт
	Сеанс = НовыйСеанс(Соединение);
	БлокировкаСеансов.Заблокировать();
	Сеансы.Вставить(Сеанс, Истина);
	БлокировкаСеансов.Разблокировать();

	Попытка
		Сеанс.Обслужить();
	Исключение
		УдалитьСеанс(Сеанс);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьСеанс(Сеанс);
КонецПроцедуры

Процедура ПрерватьОборванныеСеансы() Экспорт
	ОсвободитьБуферыОбрывов();
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Каждого Сеанс Из АктивныеСеансы() Цикл
		Попытка
			Сеанс.ПрерватьПриОбрыве(Сейчас);
		Исключение
			Лог.Ошибка(СтрШаблон("Не удалось проверить сеанс на обрыв: %1", ОписаниеОшибки()));
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// Сокеты проверяются после снятия блокировки, чтобы приём и завершение сеансов не ждали TCP.
Функция АктивныеСеансы()
	Результат = Новый Массив;
	БлокировкаСеансов.Заблокировать();
	Для Каждого Элемент Из Сеансы Цикл
		Результат.Добавить(Элемент.Ключ);
	КонецЦикла;
	БлокировкаСеансов.Разблокировать();
	Возврат Результат;
КонецФункции

Процедура УдалитьСеанс(Сеанс)
	БлокировкаСеансов.Заблокировать();
	Сеансы.Удалить(Сеанс);
	НужнаСборка = НужнаСборка Или Сеанс.ПрерванКрупныйЗапрос;
	БлокировкаСеансов.Разблокировать();
	Если Сеанс.ПрерванКрупныйЗапрос Тогда
		ОсвободитьБуферыОбрывов();
	КонецЕсли;
КонецПроцедуры

// TCP в OneScript 1.9 выделяет крупные массивы даже при чтении тела порциями. После
// обрыва они больше не нужны. Один поток собирает их для всех сеансов вне блокировки.
// На обычных запросах сборкой по-прежнему управляет сама платформа.
Процедура ОсвободитьБуферыОбрывов()
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	БлокировкаСеансов.Заблокировать();
	Если НЕ НужнаСборка Или СборкаВыполняется Или Начало < СледующаяСборка Тогда
		БлокировкаСеансов.Разблокировать();
		Возврат;
	КонецЕсли;
	НужнаСборка = Ложь;
	СборкаВыполняется = Истина;
	БлокировкаСеансов.Разблокировать();

	Попытка
		ВыполнитьСборкуМусора();
	Исключение
		Лог.Предупреждение(СтрШаблон("Не удалось освободить память после обрыва запроса: %1", ОписаниеОшибки()));
	КонецПопытки;
	КонецСборки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	БлокировкаСеансов.Заблокировать();
	СборкаВыполняется = Ложь;
	// При череде обрывов выдерживаем паузу не менее 100 мс и 20 длительностей сборки.
	СледующаяСборка = КонецСборки + Макс(100, (КонецСборки - Начало) * 20);
	БлокировкаСеансов.Разблокировать();
КонецПроцедуры

Функция НовыйСеанс(Соединение)
	ПараметрыСеанса = Новый Массив;
	ПараметрыСеанса.Добавить(Соединение);
	Попытка
		Возврат ФабрикаСеансов.Достать(ПараметрыСеанса);
	Исключение
		Соединение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции
