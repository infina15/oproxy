Перем ПроверкиПроксиСервера Экспорт;
Перем АдресСервера Экспорт;
Перем ПортСервера Экспорт;
Перем ПриветствиеХранилища;
Перем Каналы;
Перем БлокировкаКаналов;

&Пластилин
Перем Поделка;

&ЛогОпрокси
Перем Лог;

&Желудь
Процедура ПриСозданииОбъекта()
	ПриветствиеХранилища = ПолучитьДвоичныеДанныеИзHexСтроки("53F5C61A7B");
	Каналы = Новый Соответствие;
	БлокировкаКаналов = Новый БлокировкаРесурса;
КонецПроцедуры

Процедура ОбработатьСоединение(СоединениеКонфигуратора) Экспорт
	Перем ЭтоКонецСообщения, ЭтоПинг;
	КаналКонфигуратора = СоздатьКанал(СоединениеКонфигуратора);
	КаналХранилища = Неопределено;
	ТекстОшибки = "";

	Попытка
		КаналКонфигуратора.ОтправитьДвоичныеДанные(ПриветствиеХранилища);
		ДанныеСоединения = КаналКонфигуратора.ПрочитатьЧасть(ЭтоКонецСообщения, ЭтоПинг);
		Если ДанныеСоединения <> Неопределено Тогда
			СоединениеХранилища = Новый TCPСоединение(АдресСервера, ПортСервера);
			КаналХранилища = СоздатьКанал(СоединениеХранилища);
			БлокировкаКаналов.Заблокировать();
			Каналы.Вставить(КаналКонфигуратора, КаналХранилища);
			БлокировкаКаналов.Разблокировать();
			КаналХранилища.ПропуститьПриветствие(ПриветствиеХранилища.Размер());
		КонецЕсли;

		Пока ДанныеСоединения <> Неопределено Цикл
			ПараметрыЗапросаПостОбработка = Неопределено;
			Если ИзКонфигуратораВХранилище(КаналКонфигуратора, КаналХранилища, ДанныеСоединения,
					ЭтоКонецСообщения, ЭтоПинг, ПараметрыЗапросаПостОбработка) Тогда
				ИзХранилищаВКонфигуратор(КаналХранилища, КаналКонфигуратора);
				Если ПараметрыЗапросаПостОбработка <> Неопределено Тогда
					ПостОбработкаПомещенияВХранилище(ПараметрыЗапросаПостОбработка);
				КонецЕсли;
			КонецЕсли;
			ДанныеСоединения = Неопределено;
			ДанныеСоединения = КаналКонфигуратора.ПрочитатьЧасть(ЭтоКонецСообщения, ЭтоПинг);
		КонецЦикла;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	БлокировкаКаналов.Заблокировать();
	Каналы.Удалить(КаналКонфигуратора);
	БлокировкаКаналов.Разблокировать();
	КаналКонфигуратора.Закрыть();
	Если КаналХранилища <> Неопределено Тогда
		КаналХранилища.Закрыть();
	КонецЕсли;
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Лог.Ошибка(СтрШаблон("Соединение с хранилищем %1:%2 прервано. %3", АдресСервера, ПортСервера, ТекстОшибки));
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОжидающиеКаналы() Экспорт
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	БлокировкаКаналов.Заблокировать();
	Попытка
		Для Каждого Пара Из Каналы Цикл
			Пара.Ключ.ПрерватьОжиданиеПриОбрыве(Пара.Значение, Сейчас);
			Пара.Значение.ПрерватьОжиданиеПриОбрыве(Пара.Ключ, Сейчас, Истина);
		КонецЦикла;
	Исключение
		БлокировкаКаналов.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	БлокировкаКаналов.Разблокировать();
КонецПроцедуры

Функция СоздатьКанал(Соединение)
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить(Соединение);
	Попытка
		Канал = Поделка.НайтиЖелудь("КаналПрокси", ПараметрыКонструктора);
		Если Канал = Неопределено Тогда
			ВызватьИсключение "Не удалось создать канал TCP-соединения";
		КонецЕсли;
	Исключение
		Соединение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Канал;
КонецФункции

Функция ИзКонфигуратораВХранилище(КаналКонфигуратора, КаналХранилища, ДанныеСоединения,
		ЭтоКонецСообщения, ЭтоПинг, ПараметрыЗапросаПостОбработка)
	Если ЭтоПинг Тогда
		КаналХранилища.ОтправитьДвоичныеДанные(ДанныеСоединения);
		Возврат Ложь;
	КонецЕсли;
	Если КаналКонфигуратора.ПроверятьЗапрос Тогда
		Возврат ОбработатьПроверяемыйЗапрос(КаналКонфигуратора, КаналХранилища,
			ДанныеСоединения, ПараметрыЗапросаПостОбработка);
	КонецЕсли;

	ПереслатьСообщение(КаналКонфигуратора, КаналХранилища, ДанныеСоединения, ЭтоКонецСообщения);
	Возврат Истина;
КонецФункции

Процедура ПереслатьСообщение(Источник, Приемник, Знач ДанныеСоединения, Знач ЭтоКонецСообщения)
	Приемник.ОтправитьДвоичныеДанные(ДанныеСоединения);
	Пока НЕ ЭтоКонецСообщения Цикл
		ДанныеСоединения = Источник.ПрочитатьПродолжение(ЭтоКонецСообщения);
		Приемник.ОтправитьДвоичныеДанные(ДанныеСоединения);
	КонецЦикла;
КонецПроцедуры

Процедура ИзХранилищаВКонфигуратор(КаналХранилища, КаналКонфигуратора)
	Перем ЭтоКонецСообщения, ЭтоПинг;
	Пока Истина Цикл
		ДанныеСоединения = КаналХранилища.ПрочитатьЧасть(ЭтоКонецСообщения, ЭтоПинг);
		Если ДанныеСоединения = Неопределено Тогда
			ВызватьИсключение "Хранилище закрыло соединение до ответа";
		КонецЕсли;
		ПереслатьСообщение(КаналХранилища, КаналКонфигуратора, ДанныеСоединения, ЭтоКонецСообщения);
		Если НЕ ЭтоПинг Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ОбработатьПроверяемыйЗапрос(КаналКонфигуратора, КаналХранилища, Заголовок, ПараметрыЗапросаПостОбработка)
	ТелоЗапроса = Поделка.НайтиЖелудь("ТелоЗапросаХранилища");
	Если ТелоЗапроса = Неопределено Тогда
		ВызватьИсключение "Не удалось создать буфер тела запроса";
	КонецЕсли;
	Попытка
		Возврат ПрочитатьИПередатьЗапрос(КаналКонфигуратора, КаналХранилища, Заголовок,
			ТелоЗапроса, ПараметрыЗапросаПостОбработка);
	Исключение
		ТелоЗапроса.Очистить();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция ПрочитатьИПередатьЗапрос(КаналКонфигуратора, КаналХранилища, Заголовок, ТелоЗапроса, ПараметрыЗапросаПостОбработка)
	Перем ЭтоКонецСообщения;
	РазмерДляРазбора = 256;
	МетодИзвестен = Ложь;
	Пока Истина Цикл
		ДанныеСоединения = КаналКонфигуратора.ПрочитатьПродолжение(ЭтоКонецСообщения);
		Если ЭтоКонецСообщения Тогда
			Прервать;
		КонецЕсли;
		ТелоЗапроса.Добавить(ДанныеСоединения);
		Пока НЕ МетодИзвестен И ТелоЗапроса.Размер >= РазмерДляРазбора Цикл
			// До распознавания метода сохраняем начало POST, даже если имя разрезано между чтениями.
			ПараметрыЗапроса = ТелоЗапроса.ПолучитьПараметрыЗапроса(РазмерДляРазбора);
			МетодИзвестен = ЗначениеЗаполнено(ПараметрыЗапроса.ИмяМетода);
			Если МетодИзвестен И ПараметрыЗапроса.Проверять <> Истина Тогда
				КаналХранилища.ОтправитьДвоичныеДанные(Заголовок);
				ТелоЗапроса.ПередатьИОчистить(КаналХранилища);
				ДанныеСоединения = КаналКонфигуратора.ПрочитатьПродолжение(ЭтоКонецСообщения);
				ПереслатьСообщение(КаналКонфигуратора, КаналХранилища, ДанныеСоединения, ЭтоКонецСообщения);
				Возврат Истина;
			КонецЕсли;
			РазмерДляРазбора = РазмерДляРазбора * 2;
		КонецЦикла;
	КонецЦикла;
	ПараметрыЗапроса = ТелоЗапроса.ПолучитьПараметрыЗапроса();
	Если ПараметрыЗапроса.Проверять = Истина Тогда
		ТекстОшибки = ПроверитьПараметрыЗапроса(ПараметрыЗапроса);
		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			ТелоЗапроса.Очистить();
			ОтветОшибки = ОбработкаДанных.ПолучитьДвоичныеДанныеОтветаОшибки(ТекстОшибки);
			КаналКонфигуратора.ОтправитьДвоичныеДанные(ОтветОшибки);
			Возврат Ложь;
		КонецЕсли;
		ПараметрыЗапросаПостОбработка = ПараметрыЗапроса;
	КонецЕсли;

	КаналХранилища.ОтправитьДвоичныеДанные(Заголовок);
	ТелоЗапроса.ПередатьИОчистить(КаналХранилища);
	КаналХранилища.ОтправитьДвоичныеДанные(ДанныеСоединения);
	Возврат Истина;
КонецФункции

Функция ПроверитьПараметрыЗапроса(ПараметрыЗапроса)
	Попытка
		Если ПараметрыЗапроса.ИмяМетода = "DevDepot_commitObjects" Тогда
			Возврат ПроверкиПроксиСервера.ОбработкаПомещенияВХранилище(ПараметрыЗапроса);
		Иначе
			Возврат ПроверкиПроксиСервера.ОбработкаИзмененияВерсииХранилища(ПараметрыЗапроса);
		КонецЕсли;
	Исключение
		ТекстОшибки = СтрШаблон("Ошибка вызова функции в файле ""ПроверкиПроксиСервера.os"": %1", ОписаниеОшибки());
		Лог.Ошибка(ТекстОшибки);
		Возврат ТекстОшибки;
	КонецПопытки;
КонецФункции

Процедура ПостОбработкаПомещенияВХранилище(ПараметрыЗапроса)

	Попытка
		РезультатБулево = ПроверкиПроксиСервера.ПостОбработкаПомещенияВХранилище(ПараметрыЗапроса);
	Исключение
		ТекстОшибки = СтрШаблон("Ошибка вызова функции пост обработки в файле ""ПроверкиПроксиСервера.os"": %1", ОписаниеОшибки()); 
		Лог.Ошибка(ТекстОшибки);
	КонецПопытки;

КонецПроцедуры
