// Сохраняем исходные порции TCP до решения проверки и передаём их без перекодирования.
Перем Части;
Перем Размер Экспорт;

Процедура ПриСозданииОбъекта()
	Части = Новый Массив;
	Размер = 0;
КонецПроцедуры

Процедура Добавить(Данные) Экспорт
	Части.Добавить(Данные);
	Размер = Размер + Данные.Размер();
КонецПроцедуры

Функция ТекстТела(Количество)
	Если Количество = 0 Тогда
		Возврат "";
	КонецЕсли;
	Если Части[0].Размер() = Количество Тогда
		Возврат ПолучитьСтрокуИзДвоичныхДанных(Части[0]);
	КонецЕсли;

	// Декодируем UTF-8 после объединения, поскольку символ может быть разделён между чтениями.
	Буфер = Новый БуферДвоичныхДанных(Количество);
	Позиция = 0;
	Для Каждого Часть Из Части Цикл
		Длина = Мин(Часть.Размер(), Количество - Позиция);
		Буфер.Записать(Позиция, ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Часть), Длина);
		Позиция = Позиция + Длина;
		Если Позиция = Количество Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер);
КонецФункции

Функция ПараметрыЗапроса(ДлинаПрефикса = Неопределено) Экспорт
	Если ДлинаПрефикса = Неопределено Тогда
		Возврат ОбработкаДанных.ПараметрыТелаЗапроса(ТекстТела(Размер));
	КонецЕсли;
	Возврат ОбработкаДанных.ПараметрыТелаЗапроса(ТекстТела(Мин(ДлинаПрефикса, Размер)), Истина);
КонецФункции

Процедура ПередатьИОчистить(Соединение) Экспорт
	Для Индекс = 0 По Части.ВГраница() Цикл
		Соединение.ОтправитьДвоичныеДанные(Части[Индекс]);
		Части[Индекс] = Неопределено;
	КонецЦикла;
	Очистить();
КонецПроцедуры

Процедура Очистить() Экспорт
	Части.Очистить();
	Размер = 0;
КонецПроцедуры
