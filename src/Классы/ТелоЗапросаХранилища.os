// Тело проверяемого запроса. Исходные порции TCP хранятся до решения проверки
// и передаются хранилищу без перекодирования.
Перем Части;
Перем РазмерТела;

// Имя метода находится в элементе call в самом начале XML. Чтобы не декодировать
// большой запрос целиком, разбирается начало тела, удваиваясь, пока метод не найден.
Перем НачальныйРазмерРазбора;
Перем РазмерРазбора;
Перем МетодРаспознан;
Перем МетодПроверяется;

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()
	Части = Новый Массив;
	НачальныйРазмерРазбора = 256;
	Очистить();
КонецПроцедуры

Процедура Добавить(Данные) Экспорт
	Части.Добавить(Данные);
	РазмерТела = РазмерТела + Данные.Размер();
КонецПроцедуры

Функция Размер() Экспорт
	Возврат РазмерТела;
КонецФункции

// Истина, когда по началу тела уже понятно, что метод проверять не нужно.
// Пока имя метода не прочитано, тело приходится копить.
Функция МожноПереслатьБезПроверки() Экспорт
	Пока НЕ МетодРаспознан И РазмерТела >= РазмерРазбора Цикл
		Параметры = ОбработкаДанных.ПараметрыТелаЗапроса(ТекстТела(РазмерРазбора), Истина);
		МетодРаспознан = ЗначениеЗаполнено(Параметры.ИмяМетода);
		МетодПроверяется = Параметры.Проверять = Истина;
		РазмерРазбора = РазмерРазбора * 2;
	КонецЦикла;
	Возврат МетодРаспознан И НЕ МетодПроверяется;
КонецФункции

Функция ПолучитьПараметрыЗапроса() Экспорт
	Возврат ОбработкаДанных.ПараметрыТелаЗапроса(ТекстТела(РазмерТела));
КонецФункции

Процедура ПередатьИОчистить(Приемник) Экспорт
	Для Индекс = 0 По Части.ВГраница() Цикл
		Приемник.ОтправитьДвоичныеДанные(Части[Индекс]);
		Части[Индекс] = Неопределено;
	КонецЦикла;
	Очистить();
КонецПроцедуры

Процедура Очистить() Экспорт
	Части.Очистить();
	РазмерТела = 0;
	РазмерРазбора = НачальныйРазмерРазбора;
	МетодРаспознан = Ложь;
	МетодПроверяется = Ложь;
КонецПроцедуры

Функция ТекстТела(Количество)
	Если Количество = 0 Тогда
		Возврат "";
	КонецЕсли;
	Если Части[0].Размер() = Количество Тогда
		Возврат ПолучитьСтрокуИзДвоичныхДанных(Части[0]);
	КонецЕсли;

	// Декодируем UTF-8 после объединения, поскольку символ может быть разделён между чтениями.
	Буфер = Новый БуферДвоичныхДанных(Количество);
	Позиция = 0;
	Для Каждого Часть Из Части Цикл
		Длина = Мин(Часть.Размер(), Количество - Позиция);
		Буфер.Записать(Позиция, ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Часть), Длина);
		Позиция = Позиция + Длина;
		Если Позиция = Количество Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер);
КонецФункции
