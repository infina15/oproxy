&Пластилин
Перем ОбработчикСоединений;

Перем АдресСервера Экспорт;
Перем ПортСервера Экспорт;
Перем ПортПрокси Экспорт;
Перем ПутьКФайлуПроверок Экспорт;

Перем Сервер;
Перем Запущен;
Перем БлокировкаПриема;
Перем БлокировкаСчетчика;
Перем КоличествоСвободныхОбработчиков;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры 

Процедура Запустить() Экспорт
	ОбъектПроверок = РаботаСФайломПроверок.Подключить(ПутьКФайлуПроверок);
	Если ОбъектПроверок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Сервер = Новый TCPСервер(ПортПрокси);
		Сервер.Запустить();
		Шаблон = "Прокси-сервер запущен на порту %1 к хранилищу tcp://%2:%3";
		Сообщить(СтрШаблон(Шаблон, ПортПрокси, АдресСервера, ПортСервера));
	Исключение
		Шаблон =
		"
		|###################################################################################
		| >>> Ошибка запуска прокси-сервера на порту %1 к хранилищу tcp://%2:%3
		| >>> Возможно, порт %1 занят другой программой (или запущенным экземпляром этой)
		|###################################################################################
		|
		|%4";
		Сообщить(СтрШаблон(Шаблон, ПортПрокси, АдресСервера, ПортСервера, ОписаниеОшибки()));
		Возврат;
	КонецПопытки;
	ОбработчикСоединений.ПроверкиПроксиСервера = ОбъектПроверок;
	ОбработчикСоединений.АдресСервера = АдресСервера;
	ОбработчикСоединений.ПортСервера = ПортСервера;
	БлокировкаПриема = Новый БлокировкаРесурса;
	БлокировкаСчетчика = Новый БлокировкаРесурса;
	КоличествоСвободныхОбработчиков = 1;
	Запущен = Истина;
	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПриниматьСоединения", , Истина);
	Пока Запущен Цикл
		Приостановить(500);
		ОбработчикСоединений.ПроверитьОжидающиеКаналы();
	КонецЦикла;
КонецПроцедуры

Процедура ПриниматьСоединения() Экспорт
	Пока Запущен Цикл
		// Один обработчик ждёт подключение, пока остальные обслуживают свои соединения.
		БлокировкаПриема.Заблокировать();
		Если НЕ Запущен Тогда
			БлокировкаПриема.Разблокировать();
			Возврат;
		КонецЕсли;
		Попытка
			Соединение = Сервер.ОжидатьСоединения();
			ОбновитьФайлПроверок();
			БлокировкаСчетчика.Заблокировать();
			НуженНовыйОбработчик = КоличествоСвободныхОбработчиков = 1;
			Если НЕ НуженНовыйОбработчик Тогда
				КоличествоСвободныхОбработчиков = КоличествоСвободныхОбработчиков - 1;
			КонецЕсли;
			БлокировкаСчетчика.Разблокировать();
			Если НуженНовыйОбработчик Тогда
				// Текущий обработчик займётся клиентом, новый продолжит приём.
				ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПриниматьСоединения", , Истина);
			КонецЕсли;
		Исключение
			Запущен = Ложь;
			БлокировкаПриема.Разблокировать();
			Если Соединение <> Неопределено Тогда
				Соединение.Закрыть();
			КонецЕсли;
			Сервер.Остановить();
			Сообщить(ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		БлокировкаПриема.Разблокировать();

		Попытка
			ОбработчикСоединений.ОбработатьСоединение(Соединение);
		Исключение
			Сообщить(ОписаниеОшибки());
			Соединение.Закрыть();
		КонецПопытки;
		Соединение = Неопределено;
		БлокировкаСчетчика.Заблокировать();
		КоличествоСвободныхОбработчиков = КоличествоСвободныхОбработчиков + 1;
		БлокировкаСчетчика.Разблокировать();
	КонецЦикла;
КонецПроцедуры

Процедура ОбновитьФайлПроверок()
	Если РаботаСФайломПроверок.ФайлПроверокИзменился(ПутьКФайлуПроверок) Тогда
		Проверки = РаботаСФайломПроверок.Подключить(ПутьКФайлуПроверок);
		Если Проверки = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Не удалось подключить измененный файл %1", ПутьКФайлуПроверок);
		КонецЕсли;
		ОбработчикСоединений.ПроверкиПроксиСервера = Проверки;
		Сообщить(СтрШаблон("Сценарий файла проверок перезагружен так как был изменен: %1", ПутьКФайлуПроверок));
	КонецЕсли;
КонецПроцедуры
