// Общие для всех сеансов параметры. ЗапускательСервера заполняет их при старте,
// а файл проверок заменяет при его перезагрузке.
Перем АдресСервера Экспорт;
Перем ПортСервера Экспорт;
Перем Проверки Экспорт;

// Через сколько секунд молчания прокси проверяет конфигуратор пробным пингом.
// Задаётся переменной среды oproxy_client_probe или параметром oproxy.client.probe
// в autumn-properties.json.
&Деталька(Значение = "oproxy.client.probe", ЗначениеПоУмолчанию = 300)
Перем ПробаКлиентаСекунд;

// Соединение с хранилищем, по которому столько секунд ничего не передавалось, закрывается,
// и следующий запрос уходит по новому. Задаётся переменной среды oproxy_storage_idle
// или параметром oproxy.storage.idle в autumn-properties.json.
&Деталька(Значение = "oproxy.storage.idle", ЗначениеПоУмолчанию = 60)
Перем ПростойХранилищаСекунд;

// Верхняя граница числа одновременно обслуживаемых TCP-соединений конфигураторов.
&Деталька(Значение = "oproxy.workers", ЗначениеПоУмолчанию = 64)
Перем ПределОбработчиков;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// В миллисекундах.
Функция ИнтервалПробыКлиента() Экспорт
	Возврат Число(ПробаКлиентаСекунд) * 1000;
КонецФункции

// В миллисекундах.
Функция ДопустимыйПростойХранилища() Экспорт
	Возврат Число(ПростойХранилищаСекунд) * 1000;
КонецФункции

Функция МаксимумОбработчиков() Экспорт
	Предел = Число(ПределОбработчиков);
	Если Предел < 1 Или Предел <> Цел(Предел) Тогда
		ВызватьИсключение "oproxy.workers должен быть положительным целым числом";
	КонецЕсли;
	Возврат Предел;
КонецФункции
