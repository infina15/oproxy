// Непрочитанные байты и состояние обмена принадлежат одному сокету TCP-сеанса.
Перем Соединение;
Перем НачалоОжидания;
Перем ОжиданиеПослеFIN, ВремяFIN;
Перем Буфер, ПустойБуфер, Позиция;
Перем НачалоСообщения, ОсталосьТела;
Перем МаркерКонца, МаркерПинга, НачалоPOST, НачалоHTTP;
Перем ПроверятьЗапрос Экспорт;

Процедура ПриСозданииОбъекта(Источник)
	Соединение = Источник;
	НачалоОжидания = 0;
	ПустойБуфер = Новый БуферДвоичныхДанных(0);
	Буфер = ПустойБуфер;
	Позиция = 0;
	НачалоСообщения = Истина;
	МаркерКонца = ПолучитьБуферДвоичныхДанныхИзHexСтроки("6653B2A6");
	МаркерПинга = ПолучитьБуферДвоичныхДанныхИзHexСтроки("214754B3");
	НачалоPOST = ПолучитьБуферДвоичныхДанныхИзСтроки("POST");
	НачалоHTTP = ПолучитьБуферДвоичныхДанныхИзСтроки("HTTP");
КонецПроцедуры

Функция Накопить(Минимум)
	Пока Буфер.Размер - Позиция < Минимум Цикл
		Если Позиция > 0 Тогда
			Буфер = Буфер.Прочитать(Позиция, Буфер.Размер - Позиция);
			Позиция = 0;
		КонецЕсли;
		НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Данные = Соединение.ПрочитатьДвоичныеДанные();
		НачалоОжидания = 0;
		Если Данные.Размер() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		НовыйБуфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
		Если Буфер.Размер > 0 Тогда
			НовыйБуфер = Буфер.Соединить(НовыйБуфер);
		КонецЕсли;
		Буфер = НовыйБуфер;
		Позиция = 0;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура ОтправитьДвоичныеДанные(Данные) Экспорт
	НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Соединение.ОтправитьДвоичныеДанные(Данные);
	НачалоОжидания = 0;
КонецПроцедуры

Функция Активен() Экспорт
	Попытка
		Возврат Соединение.Активно;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Процедура ПрерватьОжиданиеПриОбрыве(ПарныйКанал, Сейчас, ОжидаемОтвет = Ложь) Экспорт
	Начало = НачалоОжидания;
	Если Начало = 0 Или Сейчас - Начало < 1000 Или ПарныйКанал.Активен() Тогда
		Возврат;
	КонецЕсли;
	Если ОжидаемОтвет Тогда
		Если ОжиданиеПослеFIN <> Начало Тогда
			ОжиданиеПослеFIN = Начало;
			ВремяFIN = Сейчас;
		КонецЕсли;
		// Клиент мог закрыть только запись и ещё ждать ответ. Без прогресса такая пара
		// неотличима от отключившегося клиента и молчащего хранилища.
		Если Сейчас - ВремяFIN < 30000 Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если НачалоОжидания = Начало Тогда
		Закрыть();
	КонецЕсли;
КонецПроцедуры

Процедура Закрыть() Экспорт
	Попытка
		Соединение.Закрыть();
	Исключение
		// Чтение и проверка парного сокета могут одновременно обнаружить обрыв.
	КонецПопытки;
КонецПроцедуры

Функция Взять(Размер)
	Если Позиция = 0 И Размер = Буфер.Размер Тогда
		Часть = Буфер;
	Иначе
		Часть = Буфер.Прочитать(Позиция, Размер);
	КонецЕсли;
	Позиция = Позиция + Размер;
	Если Позиция = Буфер.Размер Тогда
		Буфер = ПустойБуфер;
		Позиция = 0;
	КонецЕсли;
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Часть);
КонецФункции

Процедура ПропуститьПриветствие(Размер) Экспорт
	Если НЕ Накопить(Размер) Тогда
		ВызватьИсключение "Хранилище закрыло соединение во время приветствия";
	КонецЕсли;
	Взять(Размер);
КонецПроцедуры

Функция ЧитатьЗаголовок()
	Поток = Новый ПотокВПамяти;
	ДлинаСтроки = 0;
	Пока Накопить(1) Цикл
		Индекс = Позиция;
		Пока Индекс < Буфер.Размер Цикл
			Байт = Буфер[Индекс];
			Индекс = Индекс + 1;
			Если Байт = 10 Тогда
				Если ДлинаСтроки = 0 Тогда
					Взять(Индекс - Позиция).Записать(Поток);
					Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
				КонецЕсли;
				ДлинаСтроки = 0;
			ИначеЕсли Байт <> 13 Тогда
				ДлинаСтроки = ДлинаСтроки + 1;
			КонецЕсли;
		КонецЦикла;
		Взять(Индекс - Позиция).Записать(Поток);
	КонецЦикла;
	Поток.Закрыть();
	Возврат Неопределено;
КонецФункции

Функция ДлинаТела(Заголовок)
	Строки = СтрРазделить(НРег(ПолучитьСтрокуИзДвоичныхДанных(Заголовок)), Символы.ПС);
	Размер = Неопределено;
	Для Каждого СтрокаЗаголовка Из Строки Цикл
		Если СтрНачинаетсяС(СтрокаЗаголовка, "content-length:") Тогда
			Значение = СокрЛП(Сред(СтрокаЗаголовка, 16));
			Попытка
				Размер = Число(Значение);
				Если Размер < 0 Или Размер <> Цел(Размер) Тогда
					Размер = Неопределено;
				КонецЕсли;
			Исключение
				Размер = Неопределено;
			КонецПопытки;
		ИначеЕсли ПроверятьЗапрос И СтрНачинаетсяС(СтрокаЗаголовка, "content-type:") Тогда
			Если СтрНайти(СтрокаЗаголовка, "xml") > 0 Тогда
				// Маркер 1С не встречается в UTF-8. Это также поддерживает записи с устаревшим Content-Length.
				Возврат Неопределено;
			ИначеЕсли СтрНайти(СтрокаЗаголовка, "application/octet-stream") > 0 Тогда
				ПроверятьЗапрос = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Размер;
КонецФункции

Функция СовпадаетПрефикс(Откуда, Сигнатура)
	Если Буфер.Размер - Откуда >= 4 Тогда
		Возврат Буфер.ПрочитатьЦелое32(Откуда) = Сигнатура.ПрочитатьЦелое32(0);
	КонецЕсли;
	Для Индекс = Откуда По Буфер.Размер - 1 Цикл
		Если Буфер[Индекс] <> Сигнатура[Индекс - Откуда] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ГраницаПослеМаркера()
	После = Позиция + 4;
	Если ПроверятьЗапрос Или ОсталосьТела = 0 Или После = Буфер.Размер Тогда
		Возврат Истина;
	КонецЕсли;
	// В непрозрачных двоичных данных совпадение внутри порции может быть частью тела.
	Возврат СовпадаетПрефикс(После, МаркерПинга) Или СовпадаетПрефикс(После, НачалоPOST)
		Или СовпадаетПрефикс(После, НачалоHTTP) Или СовпадаетПрефикс(После, МаркерКонца);
КонецФункции

Функция ДлинаНачалаМаркераВХвосте()
	Для Длина = 1 По Мин(3, Буфер.Размер - Позиция) Цикл
		Если СовпадаетПрефикс(Буфер.Размер - Длина, МаркерКонца) Тогда
			Возврат Длина;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

// Конец и пинг возвращаются отдельными порциями. Остаток после них сохранён для следующего вызова.
Функция ПрочитатьЧасть(Конец, Пинг) Экспорт
	Конец = Ложь;
	Пинг = Ложь;
	Если НачалоСообщения Тогда
		Если НЕ Накопить(4) Тогда
			Возврат Неопределено;
		КонецЕсли;
		ПроверятьЗапрос = СовпадаетПрефикс(Позиция, НачалоPOST);
		Если СовпадаетПрефикс(Позиция, МаркерПинга) Тогда
			Конец = Истина;
			Пинг = Истина;
			Возврат Взять(4);
		КонецЕсли;
		НачалоСообщения = Ложь;
		ОсталосьТела = Неопределено;
		Если ПроверятьЗапрос Или СовпадаетПрефикс(Позиция, НачалоHTTP) Тогда
			Заголовок = ЧитатьЗаголовок();
			Если Заголовок <> Неопределено Тогда
				ОсталосьТела = ДлинаТела(Заголовок);
			КонецЕсли;
			Возврат Заголовок;
		КонецЕсли;
	КонецЕсли;

	Если ОсталосьТела <> Неопределено И ОсталосьТела > 0 Тогда
		Если НЕ Накопить(1) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Размер = Мин(Буфер.Размер - Позиция, ОсталосьТела);
		ОсталосьТела = ОсталосьТела - Размер;
		Возврат Взять(Размер);
	КонецЕсли;

	Если НЕ Накопить(1) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Буфер.Размер - Позиция < 4 Тогда
		МожноОтправить = Буфер.Размер - Позиция - ДлинаНачалаМаркераВХвосте();
		Если МожноОтправить > 0 Тогда
			Возврат Взять(МожноОтправить);
		КонецЕсли;
		Если НЕ Накопить(4) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если Буфер.ПрочитатьЦелое32(Позиция) = МаркерКонца.ПрочитатьЦелое32(0) Тогда
		Конец = ГраницаПослеМаркера();
		НачалоСообщения = Конец;
		Возврат Взять(4);
	КонецЕсли;

	Если Позиция = 0 Тогда
		Хвост = Буфер;
	Иначе
		Хвост = Буфер.Прочитать(Позиция, Буфер.Размер - Позиция);
	КонецЕсли;
	Части = Хвост.Разделить(МаркерКонца);
	Если Части.Количество() > 1 Тогда
		Возврат Взять(Части[0].Размер);
	КонецЕсли;
	// В OneScript 1.9 Разделить() пропускает совпадение в последней возможной позиции.
	Если Хвост.ПрочитатьЦелое32(Хвост.Размер - 4) = МаркерКонца.ПрочитатьЦелое32(0) Тогда
		Возврат Взять(Хвост.Размер - 4);
	КонецЕсли;
	Возврат Взять(Хвост.Размер - ДлинаНачалаМаркераВХвосте());
КонецФункции
