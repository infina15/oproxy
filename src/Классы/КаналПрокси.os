// Канал одного TCP-соединения. Собирает сообщения протокола хранилища
// независимо от границ чтения TCP: заголовок, тело и маркер конца читаются
// отдельными частями, а байты следующего сообщения остаются в буфере.

Перем Соединение;
Перем Сторона;               // "Конфигуратор" или "Хранилище": с неё начинаются тексты ошибок канала
Перем Закрыт;
Перем ВремяНачалаОжидания;   // мс, 0 — канал не заблокирован на чтении или отправке
Перем ВремяАктивности;       // мс, последнее чтение или отправка

Перем Буфер;
Перем ПустойБуфер;
Перем РазмерПорции;
Перем Позиция;

Перем НачалоСообщения;       // следующая часть начинает новое сообщение
Перем СообщениеЗавершено;    // последняя прочитанная часть закончила сообщение
Перем СообщениеПинг;
Перем СообщениеПроверяется;  // POST с XML, который может потребовать проверки
Перем ОсталосьБайтТела;      // по Content-Length; Неопределено — тело читается до маркера

Перем ДлинаСигнатуры;
Перем МаркерКонца;
Перем КодПС;
Перем КодВК;

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка TCPСоединение, &Блестяшка ИмяСтороны)
	Соединение = TCPСоединение;
	Сторона = ИмяСтороны;
	Закрыт = Ложь;
	ВремяНачалаОжидания = 0;
	ВремяАктивности = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПустойБуфер = Новый БуферДвоичныхДанных(0);
	РазмерПорции = 64 * 1024;
	Буфер = ПустойБуфер;
	Позиция = 0;
	НачалоСообщения = Истина;
	СообщениеЗавершено = Ложь;
	СообщениеПинг = Ложь;
	СообщениеПроверяется = Ложь;
	ДлинаСигнатуры = ПротоколХранилища.ДлинаСигнатуры();
	МаркерКонца = ПротоколХранилища.МаркерКонца();
	КодПС = КодСимвола(Символы.ПС);
	КодВК = КодСимвола(Символы.ВК);
КонецПроцедуры

#Область Чтение

// Читает очередную часть сообщения. Возвращает Неопределено, если соединение закрыто.
Функция ПрочитатьЧасть() Экспорт
	СообщениеЗавершено = Ложь;
	Если НачалоСообщения Тогда
		Если НЕ ЗаполнитьБуфер(ДлинаСигнатуры) Тогда
			Возврат Неопределено;
		КонецЕсли;
		СообщениеПинг = СовпадаетПрефикс(Позиция, ПротоколХранилища.МаркерПинга());
		СообщениеПроверяется = СовпадаетПрефикс(Позиция, ПротоколХранилища.НачалоPOST());
		ОсталосьБайтТела = Неопределено;
		Если СообщениеПинг Тогда
			СообщениеЗавершено = Истина;
			Возврат ПрочитатьИзБуфера(ДлинаСигнатуры);
		КонецЕсли;
		НачалоСообщения = Ложь;
		Если СообщениеПроверяется Или СовпадаетПрефикс(Позиция, ПротоколХранилища.НачалоHTTP()) Тогда
			Возврат ПрочитатьЗаголовок();
		КонецЕсли;
	КонецЕсли;

	Если ОсталосьБайтТела <> Неопределено И ОсталосьБайтТела > 0 Тогда
		Возврат ПрочитатьТелоПоДлине();
	КонецЕсли;
	Возврат ПрочитатьДоМаркераКонца();
КонецФункции

// Читает часть начатого сообщения. Обрыв соединения здесь — ошибка.
Функция ПрочитатьПродолжение() Экспорт
	Часть = ПрочитатьЧасть();
	Если Часть = Неопределено Тогда
		ВызватьИсключение СтрШаблон("%1: соединение закрыто до конца сообщения", Сторона);
	КонецЕсли;
	Возврат Часть;
КонецФункции

// Пересылает сообщение целиком. Возвращает Ложь, если соединение закрыто до его начала.
Функция ПереслатьСообщение(Приемник) Экспорт
	Начало = ПрочитатьЧасть();
	Если Начало = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Приемник.ОтправитьДвоичныеДанные(Начало);
	ПереслатьОстаток(Приемник);
	Возврат Истина;
КонецФункции

// Пересылает оставшиеся части текущего сообщения.
Процедура ПереслатьОстаток(Приемник) Экспорт
	Пока НЕ СообщениеЗавершено Цикл
		Приемник.ОтправитьДвоичныеДанные(ПрочитатьПродолжение());
	КонецЦикла;
КонецПроцедуры

Процедура ПропуститьПриветствие() Экспорт
	Размер = ПротоколХранилища.Приветствие().Размер();
	Если НЕ ЗаполнитьБуфер(Размер) Тогда
		ВызватьИсключение "Хранилище закрыло соединение во время приветствия";
	КонецЕсли;
	ПрочитатьИзБуфера(Размер);
КонецПроцедуры

Функция КонецСообщения() Экспорт
	Возврат СообщениеЗавершено;
КонецФункции

Функция ЭтоПинг() Экспорт
	Возврат СообщениеПинг;
КонецФункции

// Истина для POST с XML. Окончательно известно после чтения заголовка.
Функция ЭтоПроверяемыйЗапрос() Экспорт
	Возврат СообщениеПроверяется;
КонецФункции

#КонецОбласти

#Область Соединение

Процедура ОтправитьДвоичныеДанные(Данные) Экспорт
	ВремяНачалаОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Соединение.ОтправитьДвоичныеДанные(Данные);
	Исключение
		ВызватьИсключение СтрШаблон("%1: %2", Сторона, ИнформацияОбОшибке().Описание);
	КонецПопытки;
	ЗавершитьОжидание();
КонецПроцедуры

// Ложь, если соединение закрыто здесь или собеседник его закрыл.
Функция Активен() Экспорт
	Если Закрыт Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат Соединение.Активно;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Пинг, на который ответ не нужен: если собеседника больше нет, TCP сам разорвёт соединение,
// не дождавшись подтверждения. Вызывается сторожем, пока сеанс заблокирован на чтении,
// поэтому время ожидания не трогает.
Процедура ОтправитьПробныйПинг() Экспорт
	Соединение.ОтправитьДвоичныеДанные(
		ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ПротоколХранилища.МаркерПинга()));
КонецПроцедуры

// Момент начала текущего блокирующего чтения или отправки, 0 — канал не ждёт.
Функция НачалоОжидания() Экспорт
	Возврат ВремяНачалаОжидания;
КонецФункции

// Момент последнего чтения или отправки.
Функция ПоследняяАктивность() Экспорт
	Возврат ВремяАктивности;
КонецФункции

// Закрывает соединение, если канал всё ещё ждёт с момента Начало. Возвращает Истина, если закрыл.
// Вызывается сторожем из другого потока, чтобы прервать зависшее чтение или отправку.
Функция ПрерватьОжидание(Начало) Экспорт
	Если ВремяНачалаОжидания <> Начало Тогда
		Возврат Ложь;
	КонецЕсли;
	Закрыть();
	Возврат Истина;
КонецФункции

Процедура Закрыть() Экспорт
	Закрыт = Истина;
	Попытка
		Соединение.Закрыть();
	Исключение
		// Чтение и сторож могут одновременно обнаружить обрыв.
	КонецПопытки;
КонецПроцедуры

// После выхода из обмена только его обработчик может освободить непрочитанный хвост.
Процедура ЗавершитьОбмен() Экспорт
	Закрыть();
	Буфер = ПустойБуфер;
	Позиция = 0;
КонецПроцедуры

Процедура ЗавершитьОжидание()
	ВремяНачалаОжидания = 0;
	ВремяАктивности = ТекущаяУниверсальнаяДатаВМиллисекундах();
КонецПроцедуры

#КонецОбласти

#Область Буфер

Функция ЗаполнитьБуфер(НеобходимыйРазмер)
	Пока Буфер.Размер - Позиция < НеобходимыйРазмер Цикл
		Если Позиция > 0 Тогда
			Буфер = Буфер.Прочитать(Позиция, Буфер.Размер - Позиция);
			Позиция = 0;
		КонецЕсли;
		ВремяНачалаОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Попытка
			Данные = Соединение.ПрочитатьДвоичныеДанные();
		Исключение
			ВызватьИсключение СтрШаблон("%1: %2", Сторона, ИнформацияОбОшибке().Описание);
		КонецПопытки;
		ЗавершитьОжидание();
		Если Данные.Размер() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		НовыйБуфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
		// Буфер уже владеет байтами. Объект чтения не должен удерживать их до финализации.
		ОсвободитьОбъект(Данные);
		Если Буфер.Размер > 0 Тогда
			НовыйБуфер = Буфер.Соединить(НовыйБуфер);
		КонецЕсли;
		Буфер = НовыйБуфер;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПрочитатьИзБуфера(Размер)
	Если Позиция = 0 И Размер = Буфер.Размер Тогда
		Часть = Буфер;
	Иначе
		Часть = Буфер.Прочитать(Позиция, Размер);
	КонецЕсли;
	Позиция = Позиция + Размер;
	Если Позиция = Буфер.Размер Тогда
		Буфер = ПустойБуфер;
		Позиция = 0;
	КонецЕсли;
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Часть);
КонецФункции

// Сравнивает сигнатуру с буфером. Если до конца буфера меньше длины сигнатуры,
// сравнивается только доступное начало.
Функция СовпадаетПрефикс(ПозицияНачала, Сигнатура)
	Если Буфер.Размер - ПозицияНачала >= ДлинаСигнатуры Тогда
		Возврат Буфер.ПрочитатьЦелое32(ПозицияНачала) = Сигнатура.ПрочитатьЦелое32(0);
	КонецЕсли;
	Для Индекс = ПозицияНачала По Буфер.Размер - 1 Цикл
		Если Буфер[Индекс] <> Сигнатура[Индекс - ПозицияНачала] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

#КонецОбласти

#Область Заголовок

Функция ПрочитатьЗаголовок()
	Заголовок = ПрочитатьДоПустойСтроки();
	Если Заголовок <> Неопределено Тогда
		РазобратьЗаголовок(Заголовок);
	КонецЕсли;
	Возврат Заголовок;
КонецФункции

Функция ПрочитатьДоПустойСтроки()
	Поток = Новый ПотокВПамяти;
	ДлинаСтроки = 0;
	Пока ЗаполнитьБуфер(1) Цикл
		Индекс = Позиция;
		Пока Индекс < Буфер.Размер Цикл
			Байт = Буфер[Индекс];
			Индекс = Индекс + 1;
			Если Байт = КодПС Тогда
				Если ДлинаСтроки = 0 Тогда
					ПрочитатьИзБуфера(Индекс - Позиция).Записать(Поток);
					Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
				КонецЕсли;
				ДлинаСтроки = 0;
			ИначеЕсли Байт <> КодВК Тогда
				ДлинаСтроки = ДлинаСтроки + 1;
			КонецЕсли;
		КонецЦикла;
		ПрочитатьИзБуфера(Индекс - Позиция).Записать(Поток);
	КонецЦикла;
	Поток.Закрыть();
	Возврат Неопределено;
КонецФункции

// Определяет, как читать тело, и уточняет, нужно ли проверять запрос.
Процедура РазобратьЗаголовок(Заголовок)
	ДлинаТела = Неопределено;
	ТипСодержимого = "";
	Для Каждого СтрокаЗаголовка Из СтрРазделить(НРег(ПолучитьСтрокуИзДвоичныхДанных(Заголовок)), Символы.ПС) Цикл
		Если СтрНачинаетсяС(СтрокаЗаголовка, "content-length:") Тогда
			ДлинаТела = ДлинаИзЗаголовка(ЗначениеЗаголовка(СтрокаЗаголовка));
		ИначеЕсли СтрНачинаетсяС(СтрокаЗаголовка, "content-type:") Тогда
			ТипСодержимого = ЗначениеЗаголовка(СтрокаЗаголовка);
		КонецЕсли;
	КонецЦикла;

	Если СообщениеПроверяется И СтрНайти(ТипСодержимого, "xml") > 0 Тогда
		// Маркер 1С не встречается в UTF-8, поэтому XML читается до маркера,
		// даже если Content-Length устарел.
		ДлинаТела = Неопределено;
	ИначеЕсли СтрНайти(ТипСодержимого, "application/octet-stream") > 0 Тогда
		СообщениеПроверяется = Ложь;
	КонецЕсли;
	ОсталосьБайтТела = ДлинаТела;
КонецПроцедуры

Функция ЗначениеЗаголовка(СтрокаЗаголовка)
	Возврат СокрЛП(Сред(СтрокаЗаголовка, СтрНайти(СтрокаЗаголовка, ":") + 1));
КонецФункции

Функция ДлинаИзЗаголовка(Значение)
	Попытка
		Длина = Число(Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Длина < 0 Или Длина <> Цел(Длина) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Длина;
КонецФункции

#КонецОбласти

#Область Тело

Функция ПрочитатьТелоПоДлине()
	Если НЕ ЗаполнитьБуфер(1) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Размер = Мин(Буфер.Размер - Позиция, ОсталосьБайтТела, РазмерПорции);
	ОсталосьБайтТела = ОсталосьБайтТела - Размер;
	Возврат ПрочитатьИзБуфера(Размер);
КонецФункции

// Возвращает данные до маркера конца или сам маркер отдельной частью.
Функция ПрочитатьДоМаркераКонца()
	Если НЕ ЗаполнитьБуфер(1) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Буфер.Размер - Позиция < ДлинаСигнатуры Тогда
		МожноОтправить = Буфер.Размер - Позиция - ДлинаНачалаМаркераВХвосте();
		Если МожноОтправить > 0 Тогда
			Возврат ПрочитатьИзБуфера(МожноОтправить);
		КонецЕсли;
		Если НЕ ЗаполнитьБуфер(ДлинаСигнатуры) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если СовпадаетПрефикс(Позиция, МаркерКонца) Тогда
		СообщениеЗавершено = ЭтоМаркерКонцаСообщения();
		НачалоСообщения = СообщениеЗавершено;
		Возврат ПрочитатьИзБуфера(ДлинаСигнатуры);
	КонецЕсли;

	// Разделить() копирует байты по обе стороны маркера. Ищем в одной порции,
	// чтобы при каждом проходе не копировать весь непрочитанный запрос.
	Доступно = Буфер.Размер - Позиция;
	РазмерОкна = Мин(Доступно, РазмерПорции);
	Если РазмерОкна = Буфер.Размер Тогда
		Окно = Буфер;
	Иначе
		Окно = Буфер.Прочитать(Позиция, РазмерОкна);
	КонецЕсли;
	Части = Окно.Разделить(МаркерКонца);
	Если Части.Количество() > 1 Тогда
		Возврат ПрочитатьИзБуфера(Части[0].Размер);
	КонецЕсли;
	// В OneScript 1.9 Разделить() пропускает совпадение в последней возможной позиции.
	Если СовпадаетПрефикс(Позиция + РазмерОкна - ДлинаСигнатуры, МаркерКонца) Тогда
		Возврат ПрочитатьИзБуфера(РазмерОкна - ДлинаСигнатуры);
	КонецЕсли;
	Если РазмерОкна < Доступно Тогда
		// Маркер может начинаться в этой порции и заканчиваться в следующей.
		Возврат ПрочитатьИзБуфера(РазмерОкна - ДлинаСигнатуры + 1);
	КонецЕсли;
	Возврат ПрочитатьИзБуфера(РазмерОкна - ДлинаНачалаМаркераВХвосте());
КонецФункции

Функция ЭтоМаркерКонцаСообщения()
	ПозицияПослеМаркера = Позиция + ДлинаСигнатуры;
	Если СообщениеПроверяется Или ОсталосьБайтТела = 0 Или ПозицияПослеМаркера = Буфер.Размер Тогда
		Возврат Истина;
	КонецЕсли;
	// В непрозрачных двоичных данных совпадение внутри порции может быть частью тела.
	Возврат СовпадаетПрефикс(ПозицияПослеМаркера, ПротоколХранилища.МаркерПинга())
		Или СовпадаетПрефикс(ПозицияПослеМаркера, ПротоколХранилища.НачалоPOST())
		Или СовпадаетПрефикс(ПозицияПослеМаркера, ПротоколХранилища.НачалоHTTP())
		Или СовпадаетПрефикс(ПозицияПослеМаркера, МаркерКонца);
КонецФункции

// Длина начала маркера конца в самом хвосте буфера: эти байты придержим до следующего чтения.
Функция ДлинаНачалаМаркераВХвосте()
	Для Длина = 1 По Мин(ДлинаСигнатуры - 1, Буфер.Размер - Позиция) Цикл
		Если СовпадаетПрефикс(Буфер.Размер - Длина, МаркерКонца) Тогда
			Возврат Длина;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

#КонецОбласти
